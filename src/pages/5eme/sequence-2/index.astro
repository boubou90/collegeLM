---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = "Organiser ses fichiers, choisir le bon format et gérer les droits d'accès, agir face aux usages dangereux du numérique et protéger ses données personnelles.";

const activities = [
  {
    title: "Organiser ses données dans un environnement numérique",
    description: "Comment organiser ses fichiers et dossiers pour les retrouver facilement ?"
  },
  {
    title: "Choisir un format de fichier et gérer les droits d'accès",
    description: "Comment reconnaître le format d'un fichier et choisir le format adapté à chaque situation ?"
  },
  {
    title: "Agir face aux usages dangereux du numérique",
    description: "Comment reconnaître une situation de cyberviolence et agir face à celle-ci ?"
  },
  {
    title: "Se protéger et protéger ses données",
    description: "Comment construire un bouclier numérique efficace pour protéger ses données ?"
  }
];
---

<ClassLayout title="Séquence 2 – Faire bon usage des outils numériques - 5ème" level="5eme">
  <BackButton href="/5eme" />
  <h1>Séquence 2 – Faire bon usage des outils numériques</h1>

  <SequencePresentation
    title="Présentation de la séquence"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment utiliser les outils numériques au quotidien de façon sûre, responsable et efficace ?"
  />

  <ActivityLinks sequenceNumber={2} activities={activities} level="5eme" />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>