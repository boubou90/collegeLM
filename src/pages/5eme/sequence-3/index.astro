---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = "Comprendre l’évolution des outils d’écriture en étudiant leurs fonctions, leurs principes techniques, leurs familles et leurs lignées.";

const activities = [
  {
    title: "Comprendre l'évolution des outils d'écriture",
    description: "Comprendre l’évolution des outils d’écriture en étudiant leurs fonctions, leurs principes techniques, leurs familles et leurs lignées."
  }
];
---

<ClassLayout title="Séquence 3 – Comprendre l'évolution des outils d'écriture - 5ème" level="5eme">
  <BackButton href="/5eme" />
  <h1>Séquence 3 – Comprendre l'évolution des outils d'écriture</h1>

  <SequencePresentation
    title="Comprendre l'évolution des outils d'écriture"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment faire pour classer ces outils d'écriture et expliquer leurs évolutions ?"
  />

  <ActivityLinks sequenceNumber={3} activities={activities} level="5eme" />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
