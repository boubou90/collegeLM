---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const level = "5eme";
const description = `Cette séquence porte sur l'analyse des interactions d'une souris informatique avec son environnement et sur la prise en compte des contraintes de conception, notamment l'ergonomie.

Les élèves identifient les éléments en interaction avec la souris, analysent les contraintes liées à l'utilisateur, à l'environnement et au fonctionnement, puis proposent et justifient une solution de conception.

La séquence s'appuie sur une activité unique de 1h30.`;

const activities = [
  {
    title: "La souris informatique : interactions, contraintes et ergonomie",
    description: "Comprendre les interactions d'une souris informatique avec son environnement et les contraintes de conception liées à son ergonomie."
  }
];
---

<ClassLayout title="Séquence 4 – La souris informatique : interactions, contraintes et ergonomie - 5ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 4 – La souris informatique : interactions, contraintes et ergonomie</h1>

  <SequencePresentation
    title="La souris informatique : interactions, contraintes et ergonomie"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment la prise en compte de l'environnement et de l'utilisateur influence-t-elle la conception d'une souris informatique ?"
  />

  <ActivityLinks sequenceNumber={4} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
