---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = "Cette séquence permet aux élèves d'apprendre à choisir un objet technique performant et respectueux de l'environnement, en s'appuyant sur l'étude de lampes de bureau : identifier le cycle de vie d'un objet technique, exploiter une notice ou une documentation technique, puis comparer des critères de performance pour justifier un choix éco-responsable. Elle comporte deux activités d'une heure chacune, permettant d'étudier le cycle de vie, le développement durable, la documentation technique et les critères de performance d'un objet technique.";

const activities = [
  {
    title: "Comment choisir un objet performant et respectueux de l'environnement ?",
    description: "Identifier le cycle de vie d'un objet technique, exploiter une notice ou une documentation technique et repérer les matériaux et les sources d'énergie pour faire un choix plus respectueux de l'environnement."
  },
  {
    title: "Le choix d'une lampe performante et qui prend soin de la planète",
    description: "Identifier des critères de performance et les utiliser pour comparer et choisir un objet technique adapté à un besoin."
  }
];
---

<ClassLayout title="Séquence 5 - 5ème" level="5eme">
  <BackButton href="/5eme" />
  <h1>Séquence 5</h1>

  <SequencePresentation
    title="Présentation de la séquence"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment choisir un objet technique performant et respectueux de l'environnement ?"
  />

  <ActivityLinks sequenceNumber={5} activities={activities} level="5eme" />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
