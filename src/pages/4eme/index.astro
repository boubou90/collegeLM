---
import ClassLayout from '../../layouts/ClassLayout.astro';
import ProgramPresentation from '../../components/ProgramPresentation.astro';
import SequenceButtons from '../../components/SequenceButtons.astro';

const level = "4eme";
const programDescription = `En classe de quatrième, le programme de technologie se concentre sur l'étude des systèmes automatiques et leur programmation. Les élèves découvrent comment les systèmes techniques évoluent pour répondre aux besoins de la société. Ils apprennent à :

Séquence 1 :  Utiliser l’Intelligence Artificielle Générative (IAG), comme assistant personnel
Séquence 2 : Comprendre l’évolution des drones en réponse aux besoins de la société (Concours drone)
Séquence 3 : Comprendre les enjeux de la maison connectée (Gestion de l’éclairage)
Séquence 4 : Gestion du chauffage avec un système domotique
Séquence 5 : Comprendre la structure et le fonctionnement de la maison connectée
Séquence 6 : La station météo et la gestion des données
Séquence 7 : Créer un réseau local associé à une borne Wifi
Séquence 8 : Toy Rescue
Séquence 9 : Explorer le rétro gaming en créant un jeu vidéo (Concours)
Séquence 10 : Modifier un robot pour réaliser des missions`;
---


<ClassLayout title="Cours Technologie 4ème — Domotique, Arduino, Automatismes" level={level} description="Cours de technologie en 4ème : domotique, systèmes automatiques, Arduino et programmation. Séquences complètes gratuites.">

  <h1>Technologie — 4e</h1>

  <ProgramPresentation
    title="Présentation du Programme"
    description={programDescription}
  />

  <h2 class="section-title">📚 Séquences</h2>
  <SequenceButtons count={10} level={level} />

  <section class="mt-12 p-6 bg-green-50 rounded-xl" id="programme">
    <h2 class="text-xl font-bold text-green-800 mb-4">
      📚 Programme officiel de technologie en 4ème
    </h2>
    <p class="text-gray-700 mb-4">
      Conformément au programme du Ministère de l'Éducation Nationale, les élèves de 4ème
      étudient les thèmes suivants en technologie :
    </p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="bg-white rounded-lg p-4 border border-green-100">
        <h3 class="font-bold text-green-700 mb-2">🤖 Systèmes automatiques et robotique</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Étude des capteurs, actionneurs et unités de traitement qui composent les systèmes
          automatiques. Les élèves analysent des robots et des objets connectés, identifient
          leurs chaînes d'information et d'énergie, et comprennent leur fonctionnement global.
        </p>
      </div>
      <div class="bg-white rounded-lg p-4 border border-green-100">
        <h3 class="font-bold text-green-700 mb-2">💻 Programmation Python et algorithmique</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Approfondissement de la programmation avec Python : variables, boucles, fonctions,
          conditions et entrées/sorties. Les élèves écrivent des programmes pour piloter des
          systèmes réels (capteur de température, gestion de l'éclairage domotique).
        </p>
      </div>
      <div class="bg-white rounded-lg p-4 border border-green-100">
        <h3 class="font-bold text-green-700 mb-2">📊 Analyse fonctionnelle avancée</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Maîtrise des outils d'analyse : diagramme Bête à Cornes (analyse du besoin),
          diagramme Pieuvre (fonctions de service et contraintes), FAST (analyse des fonctions
          techniques). Ces outils sont indispensables pour le Brevet de 3ème.
        </p>
      </div>
      <div class="bg-white rounded-lg p-4 border border-green-100">
        <h3 class="font-bold text-green-700 mb-2">🏠 Domotique et maison connectée</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Étude des systèmes domotiques : gestion de l'éclairage, du chauffage et de la sécurité.
          Programmation de scénarios automatiques, analyse des économies d'énergie réalisables
          et réflexion sur les enjeux de la maison intelligente (vie privée, cybersécurité).
        </p>
      </div>
    </div>
    <div class="mt-4 p-3 bg-green-100 rounded-lg">
      <p class="text-sm text-green-700 font-medium">
        💡 La 4ème est l'année de la programmation avancée et des systèmes automatiques.
        Les notions vues ici (chaîne d'énergie, analyse fonctionnelle, Python) sont directement
        évaluées au Brevet des collèges en 3ème.
      </p>
    </div>
  </section>
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 3px solid #e2e8f0;
    letter-spacing: 0.01em;
  }
</style>
