---
import Layout from '../layouts/Layout.astro';
import GoogleAd from '../components/GoogleAd.astro';
import Quiz from '../components/Quiz';
import Search from '../components/Search';
---

<Layout title="Cours Technologie Collège 5e 4e 3e | Collège Louise Michel Paris" description="Cours de technologie gratuits pour les collégiens : 5ème, 4ème, 3ème. Séquences, activités, quiz et préparation au Brevet — Collège Louise Michel Paris.">
	<main>
		<div class="page-inner">

		<header class="hero" data-aos="fade-down">
			<!-- Décor : blobs animés + grille tech + spotlight -->
			<div class="hero-decor" aria-hidden="true">
				<div class="hero-spotlight"></div>
				<div class="hero-blob hero-blob-1"></div>
				<div class="hero-blob hero-blob-2"></div>
				<div class="hero-grid"></div>
			</div>
			<div class="hero-content">
				<div class="hero-text">
					<p class="hero-eyebrow">Collège Louise Michel · Paris</p>
					<h1 class="title">La technologie au Collège Louise Michel</h1>
					<p class="hero-tagline">
						Apprends, crée, programme et progresse : cours, activités, quiz et préparation au Brevet pour les élèves de la 5<sup>e</sup> à la 3<sup>e</sup>.
					</p>
					<div class="hero-cta-group">
						<a href="#niveaux" class="hero-cta hero-cta-primary">
							Découvrir mon niveau <span aria-hidden="true">→</span>
						</a>
						<a href="https://www.revizon.net/" target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta-secondary">
							Réviser avec RevizON<span class="sr-only"> (nouvel onglet)</span>
						</a>
					</div>
					<ul class="hero-concepts" role="list">
						<li>Créer</li>
						<li>Programmer</li>
						<li>Résoudre</li>
						<li>Comprendre</li>
					</ul>
				</div>

				<!-- Illustration Hero : asset graphique fourni (PNG avec transparence),
					 masquée sous 640px pour garder un Hero mobile sobre et déjà éprouvé.
					 L'annotation manuscrite est un élément HTML indépendant (pas de texte
					 gravé dans le PNG) ; elle est nichée dans le même conteneur pour
					 partager son masquage automatique sous 640px. -->
				<div class="hero-visual">
					<p class="hero-note">
						Construire aujourd'hui<br />les talents de demain&nbsp;!
						<svg class="hero-note-arrow" viewBox="0 0 40 40" fill="none" aria-hidden="true">
							<path d="M4 6C10 20 20 28 34 32" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
							<path d="M26 30L34 32L31 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</p>
					<img src="/images/hero-technology.png" alt="" class="hero-illustration" width="1672" height="941" loading="eager" />
				</div>
			</div>
		</header>

		<div class="content-wrapper">
			<div class="main-content">

				<!-- Choix du niveau -->
				<section class="level-section" id="niveaux" data-aos="fade-up" aria-labelledby="level-title">
					<h2 id="level-title" class="section-title">Je suis en…</h2>
					<p class="section-subtitle">Choisis ta classe pour retrouver toutes tes séquences.</p>
					<div class="level-grid">
						<a href="/5eme" class="level-card level-card--5eme" data-aos="fade-up" data-aos-delay="100">
							<span class="level-card-glow" aria-hidden="true"></span>
							<span class="level-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
							</span>
							<span class="level-badge">5<span class="level-badge-suffix">ème</span></span>
							<h3 class="level-card-title">Classe de 5<sup>e</sup></h3>
							<p class="level-card-desc">Réseaux informatiques, objets techniques et modélisation 3D</p>
							<span class="level-card-stat">7 séquences</span>
							<span class="level-card-cta">Découvrir <span aria-hidden="true">→</span></span>
						</a>
						<a href="/4eme" class="level-card level-card--4eme" data-aos="fade-up" data-aos-delay="200">
							<span class="level-card-glow" aria-hidden="true"></span>
							<span class="level-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
							</span>
							<span class="level-badge">4<span class="level-badge-suffix">ème</span></span>
							<h3 class="level-card-title">Classe de 4<sup>e</sup></h3>
							<p class="level-card-desc">Systèmes automatiques, programmation et analyse fonctionnelle</p>
							<span class="level-card-stat">10 séquences</span>
							<span class="level-card-cta">Découvrir <span aria-hidden="true">→</span></span>
						</a>
						<a href="/3eme" class="level-card level-card--3eme" data-aos="fade-up" data-aos-delay="300">
							<span class="level-card-glow" aria-hidden="true"></span>
							<span class="level-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4-8 4-8-4 8-4Z"/><path d="M4 11l8 4 8-4M4 15l8 4 8-4"/></svg>
							</span>
							<span class="level-badge">3<span class="level-badge-suffix">ème</span></span>
							<h3 class="level-card-title">Classe de 3<sup>e</sup></h3>
							<p class="level-card-desc">Préparation au Brevet, orientation et projets techniques avancés</p>
							<span class="level-card-stat">9 séquences</span>
							<span class="level-card-cta">Découvrir <span aria-hidden="true">→</span></span>
						</a>
					</div>
				</section>

				<!-- RevizON — section produit premium -->
				<section class="revizon-section" id="revizon" data-aos="fade-up" aria-labelledby="revizon-title">
					<div class="revizon-decor" aria-hidden="true"></div>
					<div class="revizon-inner">
						<div class="revizon-visual">
							<span class="revizon-visual-ring" aria-hidden="true"></span>
							<div class="revizon-badge-wrap">
								<img src="/images/logo-revizon.png" alt="Logo RevizON" class="revizon-logo" width="100" height="100" loading="lazy" />
							</div>
						</div>
						<div class="revizon-content">
							<p class="revizon-eyebrow">Ton application pour réussir le Brevet</p>
							<h2 id="revizon-title" class="revizon-title">
								<svg class="revizon-title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2c3 2 5 6 5 10 0 2-1 4-2 5l-3 3-3-3c-1-1-2-3-2-5 0-4 2-8 5-10Z"/><circle cx="12" cy="10" r="1.6"/><path d="M9 17l-2 4M15 17l2 4"/></svg>
								Prépare ton Brevet avec RevizON
							</h2>
							<p class="revizon-desc">
								RevizON est l'application de révision pour réussir le Brevet, notamment pensée pour les élèves de 3<sup>e</sup>.
							</p>
							<ul class="revizon-benefits" role="list">
								<li class="revizon-benefit"><span class="revizon-benefit-icon" aria-hidden="true">✓</span>Quiz par matière</li>
								<li class="revizon-benefit"><span class="revizon-benefit-icon" aria-hidden="true">✓</span>Fiches de révision</li>
								<li class="revizon-benefit"><span class="revizon-benefit-icon" aria-hidden="true">✓</span>Exercices progressifs</li>
								<li class="revizon-benefit"><span class="revizon-benefit-icon" aria-hidden="true">✓</span>Suivi de progression</li>
							</ul>
							<a href="https://www.revizon.net/" target="_blank" rel="noopener noreferrer" class="revizon-cta">
								Découvrir RevizON <span aria-hidden="true">→</span><span class="sr-only"> (nouvel onglet)</span>
							</a>
						</div>
						<!-- Véritable capture de l'application RevizON (aucun contenu recréé
							 en HTML) — le cadre reste décoratif, l'information réelle est
							 déjà présente dans le texte et les bénéfices ci-contre. -->
						<div class="revizon-phone" aria-hidden="true">
							<div class="revizon-phone-notch"></div>
							<div class="revizon-phone-screen">
								<img src="/images/revizon-app.png" alt="" width="1320" height="2868" loading="lazy" />
							</div>
						</div>
					</div>
				</section>

				<!-- Tout pour apprendre et réussir -->
				<section class="learn-section" id="ressources" data-aos="fade-up" aria-labelledby="learn-title">
					<h2 id="learn-title" class="section-title">Tout pour apprendre et réussir</h2>
					<ul class="learn-grid" role="list">
						<li>
							<a href="#niveaux" class="learn-card learn-card--cours">
								<span class="learn-icon-tile learn-icon-tile--cours" aria-hidden="true"><span class="learn-icon">📚</span></span>
								<span class="learn-label">Cours</span>
								<span class="learn-desc">Comprends les notions essentielles</span>
							</a>
						</li>
						<li>
							<a href="/4eme/sequence-1/activite-4" class="learn-card learn-card--activites">
								<span class="learn-icon-tile learn-icon-tile--activites" aria-hidden="true"><span class="learn-icon">🧪</span></span>
								<span class="learn-label">Activités</span>
								<span class="learn-desc">Mets tes connaissances en pratique</span>
							</a>
						</li>
						<li>
							<a href="#quiz" class="learn-card learn-card--quiz">
								<span class="learn-icon-tile learn-icon-tile--quiz" aria-hidden="true"><span class="learn-icon">🧠</span></span>
								<span class="learn-label">Quiz</span>
								<span class="learn-desc">Teste ce que tu as retenu</span>
							</a>
						</li>
						<li>
							<a href="#revizon" class="learn-card learn-card--revizon" aria-label="Réviser avec RevizON">
								<span class="learn-icon-tile learn-icon-tile--revizon" aria-hidden="true"><span class="learn-icon">🚀</span></span>
								<span class="learn-label">Réviser</span>
								<span class="learn-desc">avec RevizON</span>
							</a>
						</li>
						<li>
							<a href="/3eme/brevet" class="learn-card learn-card--brevet">
								<span class="learn-icon-tile learn-icon-tile--brevet" aria-hidden="true"><span class="learn-icon">🏆</span></span>
								<span class="learn-label">Brevet</span>
								<span class="learn-desc">Entraîne-toi pour l'épreuve</span>
							</a>
						</li>
						<li>
							<a href="/3eme/orientation" class="learn-card learn-card--orientation">
								<span class="learn-icon-tile learn-icon-tile--orientation" aria-hidden="true"><span class="learn-icon">🎓</span></span>
								<span class="learn-label">Orientation</span>
								<span class="learn-desc">Prépare ton avenir</span>
							</a>
						</li>
					</ul>
				</section>

				<!-- Publicité -->
				<div class="ad-slot">
					<span class="ad-slot-label">Publicité</span>
					<div class="ad-slot-frame">
						<GoogleAd slot="4342760910" format="auto" />
					</div>
				</div>

				<!-- Recherche + Quiz côte à côte sur desktop -->
				<div class="search-quiz-grid">
					<section class="search-section" id="recherche" data-aos="fade-up" aria-labelledby="search-title">
						<h2 id="search-title" class="section-title">Rechercher une ressource</h2>
						<div class="home-search-wrap">
							<Search client:load />
						</div>
					</section>

					<section class="quiz-section" id="quiz" data-aos="fade-up" aria-labelledby="quiz-title">
						<h2 id="quiz-title" class="section-title">Teste tes connaissances</h2>
						<Quiz client:load />
					</section>
				</div>

				<!-- Orientation 3e -->
				<section class="orientation-section" data-aos="fade-up" aria-labelledby="orientation-title">
					<div class="orientation-card">
						<div class="orientation-decor" aria-hidden="true"></div>
						<div class="orientation-logo-wrap">
							<img src="/images/logo-orientation3e.png" alt="Logo Orientation 3e" class="orientation-logo" width="72" height="72" loading="lazy" />
						</div>
						<div class="orientation-content">
							<p class="orientation-eyebrow">Outil d'aide à l'orientation</p>
							<h2 id="orientation-title" class="orientation-title">
								<svg class="orientation-title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.5 13 13l-3.5 1.5L11 11l3.5-1.5Z"/></svg>
								Orientation 3e&nbsp;: choisis ton avenir
							</h2>
							<p class="orientation-desc">
								Orientation 3e t'aide à y voir plus clair sur les filières, les lycées et les choix à faire après la 3<sup>e</sup>.
							</p>
						</div>
						<div class="orientation-actions">
							<a href="https://www.orientation3e.com/" target="_blank" rel="noopener noreferrer" class="orientation-cta">
								Découvrir Orientation 3e <span aria-hidden="true">→</span><span class="sr-only"> (nouvel onglet)</span>
							</a>
							<p class="orientation-note">Ton avenir<br />commence ici&nbsp;!</p>
						</div>
					</div>
				</section>

				<section class="intro-section" id="methodologie" data-aos="fade-up">
					<h2>La technologie au collège : une discipline essentielle</h2>
					<div class="intro-columns">
						<ul class="concept-chips" role="list">
							<li class="concept-chip concept-chip--creer">
								<span class="concept-chip-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg></span>
								Créer
							</li>
							<li class="concept-chip concept-chip--programmer">
								<span class="concept-chip-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12"/></svg></span>
								Programmer
							</li>
							<li class="concept-chip concept-chip--resoudre">
								<span class="concept-chip-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.6" fill="currentColor"/></svg></span>
								Résoudre
							</li>
							<li class="concept-chip concept-chip--comprendre">
								<span class="concept-chip-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a6 6 0 0 0-4 10.5c.6.6 1 1.3 1 2.5h6c0-1.2.4-1.9 1-2.5A6 6 0 0 0 12 2Z"/></svg></span>
								Comprendre
							</li>
						</ul>
						<div class="intro-text-col">
							<p class="intro-text">
								Toutes nos ressources sont alignées sur le programme officiel de technologie de l'Éducation Nationale.
							</p>
							<p class="intro-text">
								Notre approche combine théorie et pratique pour développer la créativité, l'esprit critique et les compétences numériques à travers des projets concrets : programmation, robotique, modélisation 3D.
							</p>
						</div>
					</div>
					<ul class="methodology-compact" role="list">
						<li class="methodology-compact-item">
							<h3>L'apprentissage par projet</h3>
							<p>Des projets concrets, de l'analyse du besoin jusqu'au prototype fonctionnel.</p>
						</li>
						<li class="methodology-compact-item">
							<h3>La démarche d'investigation</h3>
							<p>Observer, questionner, expérimenter pour construire ses connaissances activement.</p>
						</li>
						<li class="methodology-compact-item">
							<h3>L'interdisciplinarité</h3>
							<p>Des liens avec les mathématiques, la physique et les arts plastiques.</p>
						</li>
						<li class="methodology-compact-item">
							<h3>L'évaluation formative</h3>
							<p>Des retours réguliers pour identifier points forts et axes de progrès.</p>
						</li>
					</ul>
					<div class="signature">HB</div>
				</section>

				<!-- Liens utiles (également disponibles dans la barre du haut) -->
				<section class="useful-links-section" data-aos="fade-up" aria-labelledby="useful-links-title">
					<h2 id="useful-links-title" class="useful-links-title">Liens utiles</h2>
					<div class="useful-links-grid">
						<a href="https://pia.ac-paris.fr/serail/jcms/s1_2003410/fr/college-louise-michel"
						   target="_blank" rel="noopener noreferrer"
						   class="useful-link-card">
							<img src="/images/logo-college.svg" alt="Logo Collège Louise Michel" class="useful-link-logo" />
							<span class="useful-link-name">Collège Louise Michel</span>
							<span class="useful-link-sub">Site officiel</span>
							<span class="sr-only"> (nouvel onglet)</span>
						</a>
						<a href="https://www.parisclassenumerique.fr/"
						   target="_blank" rel="noopener noreferrer"
						   class="useful-link-card">
							<img src="/images/logo-pcn.png" alt="Logo Paris Classe Numérique" class="useful-link-logo" />
							<span class="useful-link-name">PCN / Pronote</span>
							<span class="useful-link-sub">Notes &amp; absences</span>
							<span class="sr-only"> (nouvel onglet)</span>
						</a>
						<a href="https://www.ac-paris.fr/"
						   target="_blank" rel="noopener noreferrer"
						   class="useful-link-card">
							<img src="/images/logo-academie.svg" alt="Logo Académie de Paris" class="useful-link-logo" />
							<span class="useful-link-name">Académie de Paris</span>
							<span class="useful-link-sub">Infos officielles</span>
							<span class="sr-only"> (nouvel onglet)</span>
						</a>
						<a href="https://www.orientation3e.com/"
						   target="_blank" rel="noopener noreferrer"
						   class="useful-link-card">
							<img src="/images/logo-orientation3e.png" alt="Logo Orientation 3e" class="useful-link-logo" />
							<span class="useful-link-name">Orientation 3e</span>
							<span class="sr-only"> (nouvel onglet)</span>
						</a>
					</div>
				</section>

			</div>
		</div>

		</div>
	</main>
</Layout>

<style>
	/*
	 * Direction artistique "EdTech premium" : deux thèmes cohérents, pilotés
	 * par le même attribut data-theme que Layout.astro utilise déjà pour le
	 * reste du site. On redéfinit ici les variables CSS existantes
	 * (--background, --card-bg, --text, --primary...) au niveau de <main> :
	 * palette CLAIRE par défaut ci-dessous, palette SOMBRE en override sous
	 * :global([data-theme="dark"]) main. Comme ce sont des variables
	 * héritées normalement (indépendamment du scoping Astro), tous les
	 * composants de cette page qui les utilisent déjà (y compris les
	 * overrides globaux ciblant Search.tsx) basculent automatiquement avec
	 * le thème actif, sans dupliquer de règles ni toucher Layout.astro.
	 */
	main {
		width: 100%;
		--radius-md: 1rem;
		--radius-lg: 1.25rem;
		--radius-xl: 1.75rem;
		/* Palette CLAIRE (par défaut) */
		--background: #F8FAFC;
		--card-bg: #FFFFFF;
		--border-color: #E2E8F0;
		--text: #1E293B;
		--primary: #2563EB;
		--primary-dark: #1E3A8A;
		--ink-2: #475569;
		--ink-3: #64748B;
		--shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
		--shadow-md: 0 6px 20px rgba(15, 23, 42, 0.08);
		--shadow-lg: 0 20px 45px rgba(15, 23, 42, 0.14);
		background: var(--background);
	}

	:global([data-theme="dark"]) main {
		/* Palette SOMBRE (override) */
		--background: #0B1225;
		--card-bg: #18243A;
		--border-color: #24324A;
		--text: #F1F5F9;
		--primary: #3B82F6;
		--primary-dark: #60A5FA;
		--ink-2: #CBD5E1;
		--ink-3: #94A3B8;
		--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.03);
		--shadow-md: 0 10px 28px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.04);
		--shadow-lg: 0 26px 55px rgba(0, 0, 0, 0.5), 0 0 32px rgba(59, 130, 246, 0.12);
	}

	.page-inner {
		max-width: 1600px;
		margin: 0 auto;
		padding: 1rem;
	}

	.content-wrapper {
		margin-top: 2rem;
	}

	.main-content {
		width: 100%;
		max-width: 1000px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--primary-dark);
		text-align: center;
		margin-bottom: 0.5rem;
	}

	.section-subtitle {
		text-align: center;
		color: var(--ink-3);
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ══════════ Hero ══════════ */
	.hero {
		position: relative;
		background: linear-gradient(135deg, #1e3a8a 0%, #4338ca 60%, #6d28d9 100%);
		border-radius: 1.5rem;
		margin: 1rem auto;
		max-width: 1200px;
		overflow: hidden;
		box-shadow: 0 25px 50px rgba(30, 58, 138, 0.28);
		isolation: isolate;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 20% 30%, rgba(96, 165, 250, 0.28) 0%, transparent 50%),
			radial-gradient(circle at 80% 70%, rgba(129, 140, 248, 0.24) 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}

	.hero-decor {
		position: absolute;
		inset: 0;
		overflow: hidden;
		z-index: 0;
	}

	.hero-spotlight {
		position: absolute;
		top: -25%;
		left: 30%;
		width: 520px;
		height: 520px;
		max-width: 140%;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.16) 0%, transparent 65%);
		pointer-events: none;
	}

	.hero-blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(40px);
		opacity: 0.35;
		will-change: transform;
	}

	.hero-blob-1 {
		width: 260px;
		height: 260px;
		background: #60a5fa;
		top: -60px;
		left: -60px;
		animation: blobFloat 9s ease-in-out infinite;
	}

	.hero-blob-2 {
		width: 220px;
		height: 220px;
		background: #a78bfa;
		bottom: -70px;
		right: -40px;
		animation: blobFloat 11s ease-in-out infinite reverse;
	}

	.hero-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
		background-size: 36px 36px;
		mask-image: radial-gradient(ellipse at center, black 0%, transparent 75%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 75%);
	}

	@keyframes blobFloat {
		0%, 100% { transform: translate(0, 0) scale(1); }
		50% { transform: translate(18px, -14px) scale(1.08); }
	}

	.hero-content {
		position: relative;
		padding: 2.1rem 2.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.75rem;
		z-index: 2;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		max-width: 600px;
		text-align: left;
	}

	.hero-eyebrow {
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin: 0;
		animation: fadeInUp 0.7s ease-out both;
	}

	.title {
		font-size: clamp(1.5rem, 2.3vw, 2.05rem);
		font-weight: 800;
		text-align: left;
		color: #ffffff;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
		letter-spacing: -0.02em;
		line-height: 1.15;
		margin: 0;
		padding: 0;
		animation: fadeInUp 0.8s ease-out 0.1s both;
	}

	.hero-tagline {
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.9rem;
		line-height: 1.5;
		text-align: left;
		margin: 0;
		max-width: 460px;
		animation: fadeInUp 0.8s ease-out 0.25s both;
	}

	.hero-cta-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: flex-start;
		animation: fadeInUp 0.8s ease-out 0.4s both;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		border-radius: 999px;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}

	.hero-cta-primary {
		padding: 0.65rem 1.35rem;
		font-weight: 700;
		font-size: 0.88rem;
		background: #ffffff;
		color: #1e3a8a;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
	}

	.hero-cta-primary:hover,
	.hero-cta-primary:focus-visible {
		transform: translateY(-3px);
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.26);
	}

	.hero-cta-secondary {
		padding: 0.55rem 1.15rem;
		font-weight: 600;
		font-size: 0.82rem;
		background: transparent;
		color: rgba(255, 255, 255, 0.9);
		border: 1.5px solid rgba(255, 255, 255, 0.4);
	}

	.hero-cta-secondary:hover,
	.hero-cta-secondary:focus-visible {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.65);
		transform: translateY(-2px);
	}

	.hero-cta:focus-visible {
		outline: 3px solid #ffffff;
		outline-offset: 3px;
	}

	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(16px) scale(0.98); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}

	/* Illustration Hero (asset PNG fourni, transparence conservée) —
	   dimensionnée par hauteur pour garantir un Hero compact quelle que
	   soit la largeur de colonne, et centrée verticalement dans la ligne. */
	.hero-visual {
		position: relative;
		flex-shrink: 0;
		height: 220px;
		width: auto;
		max-width: 45%;
		display: none;
		align-self: center;
	}

	.hero-illustration {
		display: block;
		height: 100%;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	.hero-note {
		position: absolute;
		top: -1.1rem;
		right: 0.25rem;
		max-width: 180px;
		margin: 0;
		font-family: 'Brush Script MT', cursive;
		font-size: 0.92rem;
		line-height: 1.25;
		color: #ffffff;
		text-align: right;
		transform: rotate(-4deg);
		z-index: 1;
		pointer-events: none;
	}

	.hero-note-arrow {
		display: block;
		width: 26px;
		height: 26px;
		margin: 0.1rem 0 0 auto;
		color: #ffffff;
		opacity: 0.85;
	}

	/* Concepts intégrés en ligne compacte (plus de colonne isolée) */
	.hero-concepts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0;
	}

	.hero-concepts li {
		font-size: 0.66rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgba(255, 255, 255, 0.7);
	}

	.hero-concepts li:not(:last-child)::after {
		content: '·';
		margin: 0 0.4rem;
		color: rgba(255, 255, 255, 0.4);
	}

	@media (min-width: 640px) {
		.hero-visual {
			display: flex;
		}
	}

	/* ══════════ Choix du niveau ══════════ */
	.level-section {
		margin-top: 2.75rem;
	}

	.level-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.level-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 1.5rem 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-lg);
		border-top: 4px solid transparent;
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.level-card-glow {
		position: absolute;
		inset: -15% -15% auto -15%;
		height: 130%;
		border-radius: 50%;
		opacity: 0;
		transition: opacity 0.35s ease;
		pointer-events: none;
	}

	.level-card--5eme .level-card-glow { background: radial-gradient(circle, rgba(59,130,246,0.16), transparent 70%); }
	.level-card--4eme .level-card-glow { background: radial-gradient(circle, rgba(16,185,129,0.16), transparent 70%); }
	.level-card--3eme .level-card-glow { background: radial-gradient(circle, rgba(249,115,22,0.16), transparent 70%); }

	.level-card:hover,
	.level-card:focus-visible {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
	}

	.level-card:hover .level-card-glow {
		opacity: 1;
	}

	.level-card:hover .level-icon {
		transform: scale(1.1);
	}

	.level-card:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 2px;
	}

	.level-card-cta span[aria-hidden] {
		display: inline-block;
		transition: transform 0.25s ease;
	}

	.level-card:hover .level-card-cta span[aria-hidden] {
		transform: translateX(4px);
	}

	.level-card--5eme { border-top-color: #3B82F6; }
	.level-card--4eme { border-top-color: #10B981; }
	.level-card--3eme { border-top-color: #F97316; }

	.level-icon {
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.65rem;
		margin-bottom: 0.55rem;
		transition: transform 0.25s ease;
	}

	.level-icon svg { width: 1.35rem; height: 1.35rem; }

	.level-card--5eme .level-icon { background: rgba(59,130,246,0.14); color: #3B82F6; }
	.level-card--4eme .level-icon { background: rgba(16,185,129,0.14); color: #10B981; }
	.level-card--3eme .level-icon { background: rgba(249,115,22,0.14); color: #F97316; }

	:global([data-theme="dark"]) .level-card--5eme .level-icon { background: rgba(59,130,246,0.18); color: #60a5fa; }
	:global([data-theme="dark"]) .level-card--4eme .level-icon { background: rgba(16,185,129,0.18); color: #34d399; }
	:global([data-theme="dark"]) .level-card--3eme .level-icon { background: rgba(249,115,22,0.18); color: #fb923c; }

	.level-badge {
		font-size: 1.5rem;
		font-weight: 800;
		line-height: 1;
	}

	.level-badge-suffix {
		font-size: 0.85rem;
		font-weight: 700;
		margin-left: 0.1rem;
	}

	.level-card--5eme .level-badge { color: #3B82F6; }
	.level-card--4eme .level-badge { color: #10B981; }
	.level-card--3eme .level-badge { color: #F97316; }

	:global([data-theme="dark"]) .level-card--5eme .level-badge { color: #60a5fa; }
	:global([data-theme="dark"]) .level-card--4eme .level-badge { color: #34d399; }
	:global([data-theme="dark"]) .level-card--3eme .level-badge { color: #fb923c; }

	.level-card-title {
		font-size: 1.1rem;
		line-height: 1.25;
		color: var(--text);
		margin-top: 0.3rem;
	}

	.level-card-desc {
		margin-top: 0.4rem;
		color: var(--ink-2);
		font-size: 0.88rem;
		line-height: 1.4;
	}

	.level-card-stat {
		margin-top: 0.6rem;
		font-size: 0.7rem;
		line-height: 1.2;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-3);
		background: var(--background);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		padding: 0.2rem 0.7rem;
	}

	.level-card-cta {
		margin-top: 0.6rem;
		font-weight: 700;
		font-size: 0.88rem;
		line-height: 1.2;
		color: var(--primary-dark);
	}

	/* ══════════ RevizON ══════════ */
	.revizon-section {
		position: relative;
		margin-top: 3rem;
		border-radius: 1.5rem;
		overflow: hidden;
		background: linear-gradient(135deg, #4c1d95 0%, #5b21b6 45%, #1e3a8a 100%);
		box-shadow: var(--shadow-lg);
	}

	.revizon-decor {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 15% 20%, rgba(167,139,250,0.35) 0%, transparent 45%),
			radial-gradient(circle at 85% 80%, rgba(96,165,250,0.3) 0%, transparent 45%),
			radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px);
		background-size: auto, auto, 26px 26px;
		pointer-events: none;
	}

	.revizon-inner {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.75rem;
		padding: 1.9rem;
		z-index: 1;
	}

	.revizon-visual {
		position: relative;
		flex-shrink: 0;
		width: 136px;
		height: 136px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.revizon-visual-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1.5px dashed rgba(255, 255, 255, 0.35);
		animation: ringSpin 24s linear infinite;
	}

	@keyframes ringSpin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.revizon-badge-wrap {
		position: relative;
		width: 108px;
		height: 108px;
		border-radius: var(--radius-lg);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
	}

	.revizon-logo {
		width: 84px;
		height: 84px;
		object-fit: contain;
		border-radius: 0.85rem;
	}

	.revizon-content {
		flex: 1;
		min-width: 0;
	}

	.revizon-eyebrow {
		color: rgba(255, 255, 255, 0.92);
		font-size: 0.75rem;
		line-height: 1.2;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin: 0 0 0.4rem;
	}

	.revizon-title {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		color: #ffffff;
		font-size: 1.3rem;
		font-weight: 800;
		margin: 0 0 0.45rem;
		line-height: 1.25;
	}

	.revizon-title-icon {
		width: 1.3em;
		height: 1.3em;
		flex-shrink: 0;
		color: #fbbf24;
	}

	.revizon-desc {
		color: rgba(255, 255, 255, 0.92);
		font-size: 0.92rem;
		line-height: 1.5;
		margin: 0 0 0.85rem;
		max-width: 480px;
	}

	.revizon-benefits {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.revizon-benefit {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 999px;
		padding: 0.4rem 0.9rem;
		color: rgba(255, 255, 255, 0.96);
		font-size: 0.8rem;
		line-height: 1.2;
		font-weight: 600;
	}

	.revizon-benefit-icon {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.2);
		font-size: 0.66rem;
		font-weight: 700;
	}

	.revizon-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: #ffffff;
		color: #4c1d95;
		font-weight: 800;
		font-size: 0.9rem;
		line-height: 1.2;
		padding: 0.7rem 1.4rem;
		border-radius: 999px;
		text-decoration: none;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.revizon-cta:hover,
	.revizon-cta:focus-visible {
		transform: translateY(-3px);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
	}

	.revizon-cta:focus-visible {
		outline: 3px solid #ffffff;
		outline-offset: 3px;
	}

	/* Cadre smartphone (visible seulement sur grand écran, décoratif) —
	   contient la véritable capture de l'application, jamais recréée en HTML. */
	.revizon-phone {
		display: none;
		flex-shrink: 0;
		width: 132px;
		background: #0b1225;
		border: 3px solid #2a2558;
		border-radius: 1.4rem;
		padding: 1.3rem 0.75rem 0.75rem;
		position: relative;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
	}

	.revizon-phone-notch {
		position: absolute;
		top: 0.5rem;
		left: 50%;
		transform: translateX(-50%);
		width: 38px;
		height: 5px;
		border-radius: 3px;
		background: #2a2558;
		z-index: 1;
	}

	.revizon-phone-screen {
		display: block;
		width: 100%;
		border-radius: 0.9rem;
		overflow: hidden;
		line-height: 0;
	}

	.revizon-phone-screen img {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (min-width: 1100px) {
		.revizon-phone {
			display: block;
		}
	}

	/* ══════════ Tout pour apprendre et réussir ══════════ */
	.learn-section {
		margin-top: 2rem;
	}

	.learn-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.85rem;
	}

	.learn-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		height: 100%;
		padding: 1.15rem 0.6rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-top: 3px solid transparent;
		border-radius: 24px;
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.learn-card:hover,
	.learn-card:focus-visible {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
		border-color: var(--primary);
	}

	/* Liseré supérieur permanent, fin et sans glow, sur les 6 cartes —
	   repère de couleur discret propre à chaque fonction. */
	.learn-card--cours { border-top-color: #3B82F6; }
	.learn-card--activites { border-top-color: #10B981; }
	.learn-card--quiz { border-top-color: #7c3aed; }
	.learn-card--revizon { border-top-color: #ec4899; }
	.learn-card--brevet { border-top-color: #F97316; }
	.learn-card--orientation { border-top-color: #6366f1; }

	.learn-card--cours:hover { border-color: #3B82F6; }
	.learn-card--activites:hover { border-color: #10B981; }
	.learn-card--quiz:hover { border-color: #7c3aed; }
	.learn-card--revizon:hover { border-color: #ec4899; }
	.learn-card--brevet:hover { border-color: #F97316; }
	.learn-card--orientation:hover { border-color: #6366f1; }

	.learn-icon-tile {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.65rem;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.25s ease;
	}

	.learn-card:hover .learn-icon-tile {
		transform: scale(1.1);
	}

	.learn-icon-tile--cours { background: rgba(59,130,246,0.18); }
	.learn-icon-tile--activites { background: rgba(16,185,129,0.18); }
	.learn-icon-tile--quiz { background: rgba(124,58,237,0.2); }
	.learn-icon-tile--revizon { background: rgba(236,72,153,0.2); }
	.learn-icon-tile--brevet { background: rgba(249,115,22,0.18); }
	.learn-icon-tile--orientation { background: rgba(99,102,241,0.2); }

	.learn-icon {
		font-size: 1.3rem;
	}

	.learn-label {
		font-weight: 700;
		font-size: 0.92rem;
		color: var(--text);
	}

	.learn-desc {
		font-size: 0.74rem;
		color: var(--ink-3);
		text-align: center;
	}

	/* ══════════ Publicité ══════════ */
	.ad-slot {
		margin: 2rem auto 0;
		max-width: 468px;
		padding-block: 0.65rem;
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
	}

	.ad-slot-label {
		font-size: 0.6rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-3);
		opacity: 0.7;
	}

	.ad-slot-frame {
		width: 100%;
		display: flex;
		justify-content: center;
	}

	/* ══════════ Recherche + Quiz ══════════ */
	.search-quiz-grid {
		margin-top: 3rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
