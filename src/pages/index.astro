---
import Layout from '../layouts/Layout.astro';
import GoogleAd from '../components/GoogleAd.astro';
import Quiz from '../components/Quiz';
import Search from '../components/Search';
---

<Layout title="Cours Technologie Collège 5e 4e 3e | Collège Louise Michel Paris" description="Cours de technologie gratuits pour les collégiens : 5ème, 4ème, 3ème. Séquences, activités, quiz et préparation au Brevet — Collège Louise Michel Paris.">
	<main>
		<header class="hero" data-aos="fade-down">
			<!-- Emojis flottants décoratifs -->
			<div class="hero-emoji" style="left: 4%; top: 18%">⚙️</div>
			<div class="hero-emoji hero-emoji-2" style="right: 5%; top: 14%">🤖</div>
			<div class="hero-emoji hero-emoji-3" style="left: 7%; bottom: 16%">💡</div>
			<div class="hero-emoji hero-emoji-4" style="right: 6%; bottom: 20%">🔬</div>
			<div class="hero-content">
				<div class="hero-text">
					<h1 class="title">La technologie au collège</h1>
					<p class="hero-subtitle">Découvre • Comprends • Crée</p>
					<p class="hero-tagline">
						Un site pédagogique pour accompagner les élèves de la 5<sup>e</sup> à la 3<sup>e</sup> :
						cours, activités, quiz et préparation au Brevet.
					</p>
				</div>
			</div>
		</header>

		<div class="content-wrapper">
			<div class="main-content">

				<!-- Sélecteur de profil -->
				<section class="profile-selector-section" data-aos="fade-up" aria-labelledby="profile-title">
					<h2 id="profile-title" class="profile-title">Bienvenue&nbsp;! Tu es…</h2>
					<div id="profile-selector" role="group" aria-label="Choisis ton profil">
						<button type="button" data-profile="eleve" data-target="#niveaux" class="profile-card profile-card--eleve" aria-pressed="false">
							<span class="profile-icon" aria-hidden="true">👦</span>
							<span class="profile-name">Élève</span>
							<span class="profile-desc">Accède à tes cours, activités, quiz et révisions.</span>
						</button>
						<button type="button" data-profile="parent" data-target="#ressources" class="profile-card profile-card--parent" aria-pressed="false">
							<span class="profile-icon" aria-hidden="true">👨‍👩‍👧</span>
							<span class="profile-name">Parent</span>
							<span class="profile-desc">Retrouvez les ressources et informations utiles pour accompagner votre enfant.</span>
						</button>
						<button type="button" data-profile="enseignant" data-target="#methodologie" class="profile-card profile-card--enseignant" aria-pressed="false">
							<span class="profile-icon" aria-hidden="true">👩‍🏫</span>
							<span class="profile-name">Enseignant</span>
							<span class="profile-desc">Découvrez les ressources pédagogiques et la démarche utilisée.</span>
						</button>
					</div>
				</section>

				<script>
					const saved = localStorage.getItem('userProfile');
					const buttons = document.querySelectorAll<HTMLButtonElement>('.profile-card');

					if (saved) {
						buttons.forEach(btn => {
							if (btn.dataset.profile === saved) {
								btn.classList.add('profile-card--active');
								btn.setAttribute('aria-pressed', 'true');
							}
						});
					}

					buttons.forEach(btn => {
						btn.addEventListener('click', () => {
							buttons.forEach(b => {
								b.classList.remove('profile-card--active');
								b.setAttribute('aria-pressed', 'false');
							});
							btn.classList.add('profile-card--active');
							btn.setAttribute('aria-pressed', 'true');
							localStorage.setItem('userProfile', btn.dataset.profile!);
							const target = document.querySelector(btn.dataset.target!);
							if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
						});
					});
				</script>

				<!-- Accès rapides -->
				<nav class="quick-links-section" data-aos="fade-up" aria-labelledby="quick-links-title">
					<h2 id="quick-links-title" class="section-title">Que veux-tu faire&nbsp;?</h2>
					<ul class="quick-links-grid" role="list">
						<li>
							<a href="#niveaux" class="quick-link-card">
								<span class="qlc-icon" aria-hidden="true">📚</span>
								<span class="qlc-label">Cours</span>
								<span class="qlc-desc">Choisis ton niveau</span>
							</a>
						</li>
						<li>
							<a href="/4eme/sequence-1/activite-4" class="quick-link-card">
								<span class="qlc-icon" aria-hidden="true">🧪</span>
								<span class="qlc-label">Activités</span>
								<span class="qlc-desc">Travaux pratiques</span>
							</a>
						</li>
						<li>
							<a href="#quiz" class="quick-link-card">
								<span class="qlc-icon" aria-hidden="true">🧠</span>
								<span class="qlc-label">Quiz</span>
								<span class="qlc-desc">Teste-toi</span>
							</a>
						</li>
						<li>
							<a href="/3eme/brevet" class="quick-link-card">
								<span class="qlc-icon" aria-hidden="true">🏆</span>
								<span class="qlc-label">Brevet</span>
								<span class="qlc-desc">Prépare l'épreuve</span>
							</a>
						</li>
						<li>
							<a href="/3eme/orientation" class="quick-link-card">
								<span class="qlc-icon" aria-hidden="true">🎓</span>
								<span class="qlc-label">Orientation</span>
								<span class="qlc-desc">Après la 3ème</span>
							</a>
						</li>
						<li>
							<a href="#recherche" class="quick-link-card">
								<span class="qlc-icon" aria-hidden="true">🔎</span>
								<span class="qlc-label">Recherche</span>
								<span class="qlc-desc">Trouve une ressource</span>
							</a>
						</li>
					</ul>
				</nav>

				<!-- Recherche -->
				<section class="search-section" id="recherche" data-aos="fade-up" aria-labelledby="search-title">
					<h2 id="search-title" class="section-title">Rechercher une ressource</h2>
					<div class="home-search-wrap">
						<Search client:load />
					</div>
				</section>

				<!-- Choix du niveau -->
				<section class="level-section" id="niveaux" data-aos="fade-up" aria-labelledby="level-title">
					<h2 id="level-title" class="section-title">Choisis ton niveau</h2>
					<div class="level-grid">
						<a href="/5eme" class="level-card level-card--5eme" data-aos="fade-up" data-aos-delay="100">
							<span class="level-badge">5<span class="level-badge-suffix">ème</span></span>
							<h3 class="level-card-title">Classe de 5<sup>e</sup></h3>
							<p class="level-card-desc">Découverte des réseaux, objets techniques et modélisation 3D</p>
							<span class="level-card-stat">10 séquences</span>
							<span class="level-card-cta">Découvrir <span aria-hidden="true">→</span></span>
						</a>
						<a href="/4eme" class="level-card level-card--4eme" data-aos="fade-up" data-aos-delay="200">
							<span class="level-badge">4<span class="level-badge-suffix">ème</span></span>
							<h3 class="level-card-title">Classe de 4<sup>e</sup></h3>
							<p class="level-card-desc">Systèmes automatiques, programmation et analyse fonctionnelle</p>
							<span class="level-card-stat">10 séquences</span>
							<span class="level-card-cta">Découvrir <span aria-hidden="true">→</span></span>
						</a>
						<a href="/3eme" class="level-card level-card--3eme" data-aos="fade-up" data-aos-delay="300">
							<span class="level-badge">3<span class="level-badge-suffix">ème</span></span>
							<h3 class="level-card-title">Classe de 3<sup>e</sup></h3>
							<p class="level-card-desc">Préparation au Brevet, orientation et projets techniques avancés</p>
							<span class="level-card-stat">10 séquences</span>
							<span class="level-card-cta">Découvrir <span aria-hidden="true">→</span></span>
						</a>
					</div>
				</section>

				<!-- Brevet & Orientation (spécial 3e) -->
				<section class="showcase-section" data-aos="fade-up" aria-label="Ressources spéciales 3ème">
					<p class="showcase-eyebrow">Spécial 3<sup>e</sup></p>
					<div class="showcase-grid">
						<a href="/3eme/brevet" class="showcase-card showcase-card--brevet">
							<span class="showcase-icon" aria-hidden="true">🎯</span>
							<h3 class="showcase-title">Prépare ton Brevet</h3>
							<p class="showcase-desc">Sujets d'entraînement, corrigés et fiches de révision pour l'épreuve de technologie.</p>
							<span class="showcase-cta">Voir la préparation <span aria-hidden="true">→</span></span>
						</a>
						<a href="/3eme/orientation" class="showcase-card showcase-card--orientation">
							<span class="showcase-icon" aria-hidden="true">🎓</span>
							<h3 class="showcase-title">Prépare ton orientation</h3>
							<p class="showcase-desc">Lycées, filières et affectation après la 3ème pour bien choisir la suite.</p>
							<span class="showcase-cta">Découvrir l'orientation <span aria-hidden="true">→</span></span>
						</a>
					</div>
				</section>

				<!-- Publicité -->
				<GoogleAd slot="4342760910" format="auto" />

				<!-- Quiz -->
				<section class="quiz-section" id="quiz" data-aos="fade-up" aria-labelledby="quiz-title">
					<h2 id="quiz-title" class="section-title">Teste tes connaissances</h2>
					<Quiz client:load />
				</section>

				<section class="intro-section" data-aos="fade-up">
					<h2>Bienvenue sur le site de technologie du Collège Louise Michel</h2>
					<p class="intro-text">
						Ce site est dédié aux élèves, parents et enseignants qui souhaitent approfondir leurs connaissances en technologie au collège. Vous y trouverez des ressources pédagogiques complètes, des activités pratiques et des supports de cours pour les classes de 5ème, 4ème et 3ème.
					</p>
					<p class="intro-text">
						La technologie est une discipline essentielle qui permet de comprendre le monde qui nous entoure et de développer des compétences cruciales pour l'avenir. Notre approche pédagogique combine théorie et pratique pour une meilleure compréhension des concepts.
					</p>
				</section>

				<section class="presentation" data-aos="fade-up">
					<h2>La technologie au collège : une discipline essentielle</h2>
					<div class="presentation-content">
						<p class="presentation-lead">
							La technologie est une discipline fondamentale qui permet aux élèves de comprendre le monde qui les entoure. Elle développe :
						</p>
						<ul class="benefits-list" role="list">
							<li>
								<span class="list-card-icon" aria-hidden="true">✓</span>
								<span><strong>La créativité et l'innovation</strong> à travers des projets concrets comme la conception d'objets techniques, la programmation de robots ou la modélisation 3D</span>
							</li>
							<li>
								<span class="list-card-icon" aria-hidden="true">✓</span>
								<span><strong>L'esprit critique et la démarche scientifique</strong> par l'analyse de systèmes techniques, la résolution de problèmes et l'expérimentation</span>
							</li>
							<li>
								<span class="list-card-icon" aria-hidden="true">✓</span>
								<span><strong>Les compétences numériques essentielles</strong> incluant la programmation, la modélisation et l'utilisation d'outils de conception assistée par ordinateur</span>
							</li>
							<li>
								<span class="list-card-icon" aria-hidden="true">✓</span>
								<span><strong>La capacité à travailler en équipe</strong> grâce à des projets collaboratifs qui simulent des situations professionnelles réelles</span>
							</li>
						</ul>
						<p class="presentation-lead">
							Notre approche pédagogique combine théorie et pratique, permettant aux élèves de :
						</p>
						<ul class="approach-list" role="list">
							<li>
								<span class="list-card-icon" aria-hidden="true">→</span>
								<span><strong>Réaliser des projets techniques innovants</strong> qui répondent à des problématiques concrètes et actuelles</span>
							</li>
							<li>
								<span class="list-card-icon" aria-hidden="true">→</span>
								<span><strong>Utiliser des outils numériques modernes</strong> comme les logiciels de CAO, les plateformes de programmation et les imprimantes 3D</span>
							</li>
							<li>
								<span class="list-card-icon" aria-hidden="true">→</span>
								<span><strong>Comprendre les enjeux technologiques actuels</strong> tels que le développement durable, l'intelligence artificielle et la robotique</span>
							</li>
							<li>
								<span class="list-card-icon" aria-hidden="true">→</span>
								<span><strong>Développer des compétences pour leur futur</strong> qui seront valorisées dans leurs études supérieures et leur vie professionnelle</span>
							</li>
						</ul>
					</div>
					<div class="signature">HB</div>
				</section>

				<section class="program-highlights" data-aos="fade-up">
					<h2>Points forts du programme</h2>
					<div class="highlights-grid">
						<div class="highlight-card">
							<h3>Classe de 5ème</h3>
							<ul>
								<li>Découverte des réseaux informatiques et de leur fonctionnement</li>
								<li>Analyse des objets techniques et de leur évolution</li>
								<li>Initiation à la modélisation 3D avec SketchUp</li>
								<li>Sensibilisation aux enjeux de la sécurité numérique</li>
							</ul>
						</div>
						<div class="highlight-card">
							<h3>Classe de 4ème</h3>
							<ul>
								<li>Étude des systèmes automatiques et de leur programmation</li>
								<li>Analyse fonctionnelle avec les diagrammes "Bête à Cornes" et "Pieuvre"</li>
								<li>Projets pratiques comme la conception d'une barrière automatique</li>
								<li>Découverte des principes de l'électronique et de la domotique</li>
							</ul>
						</div>
						<div class="highlight-card">
							<h3>Classe de 3ème</h3>
							<ul>
								<li>Préparation aux épreuves de technologie du Brevet</li>
								<li>Projets techniques avancés intégrant programmation et conception</li>
								<li>Orientation post-3ème et découverte des filières technologiques</li>
								<li>Approfondissement des chaînes d'énergie et d'information</li>
							</ul>
						</div>
					</div>
				</section>

				<section class="methodology" id="methodologie" data-aos="fade-up">
					<h2>Notre méthodologie pédagogique</h2>
					<div class="methodology-content">
						<p>
							Notre enseignement de la technologie repose sur une approche par compétences qui permet aux élèves de développer des savoir-faire concrets et transférables. Nous privilégions :
						</p>
						<div class="methodology-grid">
							<div class="methodology-item">
								<h3>L'apprentissage par projet</h3>
								<p>Les élèves travaillent sur des projets concrets qui les amènent à résoudre des problèmes techniques réels, depuis l'analyse du besoin jusqu'à la réalisation d'un prototype fonctionnel.</p>
							</div>
							<div class="methodology-item">
								<h3>La démarche d'investigation</h3>
								<p>Nous encourageons les élèves à observer, questionner, expérimenter et analyser pour construire leurs connaissances de manière active et développer leur esprit critique.</p>
							</div>
							<div class="methodology-item">
								<h3>L'interdisciplinarité</h3>
								<p>Nos activités font appel à des connaissances et compétences issues de différentes disciplines (mathématiques, physique, arts plastiques...) pour montrer les liens entre la technologie et les autres domaines.</p>
							</div>
							<div class="methodology-item">
								<h3>L'évaluation formative</h3>
								<p>Nous privilégions une évaluation qui accompagne l'apprentissage, avec des retours réguliers permettant aux élèves d'identifier leurs points forts et leurs axes d'amélioration.</p>
							</div>
						</div>
					</div>
				</section>

				<section class="resources-section" id="ressources" data-aos="fade-up">
					<h2>Ressources pédagogiques</h2>
					<p class="resources-intro">
						Notre site propose une variété de ressources pédagogiques pour accompagner l'apprentissage de la technologie :
					</p>
					<div class="resources-grid">
						<div class="resource-card">
							<h3>Fiches de cours</h3>
							<p>Documents synthétiques présentant les notions essentielles du programme de technologie, avec des explications claires et des illustrations.</p>
							<a href="/5eme/sequence-1/resources" class="resource-link">Voir un exemple</a>
						</div>
						<div class="resource-card">
							<h3>Activités pratiques</h3>
							<p>Exercices et travaux pratiques permettant d'appliquer les connaissances théoriques à des situations concrètes et de développer des compétences techniques.</p>
							<a href="/4eme/sequence-1/activite-4" class="resource-link">Voir un exemple</a>
						</div>
						<div class="resource-card">
							<h3>Préparation au Brevet</h3>
							<p>Sujets d'entraînement, fiches de révision et conseils méthodologiques pour réussir l'épreuve de technologie du Brevet des collèges.</p>
							<a href="/3eme/brevet" class="resource-link">Accéder aux ressources</a>
						</div>
						<div class="resource-card">
							<h3>Orientation</h3>
							<p>Informations sur les filières technologiques post-3ème, les lycées professionnels et généraux, et les métiers liés à la technologie.</p>
							<a href="/3eme/orientation" class="resource-link">Découvrir les options</a>
						</div>
					</div>
				</section>

				<!-- Liens utiles (également disponibles dans la barre du haut) -->
				<section class="useful-links-section" data-aos="fade-up" aria-labelledby="useful-links-title">
					<h2 id="useful-links-title" class="useful-links-title">Liens utiles</h2>
					<div class="useful-links-grid">
						<a href="https://pia.ac-paris.fr/serail/jcms/s1_2003410/fr/college-louise-michel"
						   target="_blank" rel="noopener noreferrer"
						   class="useful-link-card">
							<img src="/images/logo-college.svg" alt="Logo Collège Louise Michel" class="useful-link-logo" />
							<span class="useful-link-name">Collège Louise Michel</span>
							<span class="useful-link-sub">Site officiel</span>
						</a>
						<a href="https://www.parisclassenumerique.fr/"
						   target="_blank" rel="noopener noreferrer"
						   class="useful-link-card">
							<img src="/images/logo-pcn.png" alt="Logo Paris Classe Numérique" class="useful-link-logo" />
							<span class="useful-link-name">PCN / Pronote</span>
							<span class="useful-link-sub">Notes &amp; absences</span>
						</a>
						<a href="https://www.ac-paris.fr/"
						   target="_blank" rel="noopener noreferrer"
						   class="useful-link-card">
							<img src="/images/logo-academie.svg" alt="Logo Académie de Paris" class="useful-link-logo" />
							<span class="useful-link-name">Académie de Paris</span>
							<span class="useful-link-sub">Infos officielles</span>
						</a>
					</div>
				</section>

			</div>
		</div>
	</main>
</Layout>

<style>
	main {
		max-width: 1600px;
		margin: 0 auto;
		padding: 1rem;
		--radius-md: 1rem;
		--radius-lg: 1.25rem;
		--shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
		--shadow-md: 0 6px 20px rgba(15, 23, 42, 0.08);
		--ink-2: #475569;
		--ink-3: #64748b;
	}

	.content-wrapper {
		margin-top: 2rem;
	}

	.main-content {
		width: 100%;
		max-width: 1000px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--primary-dark);
		text-align: center;
		margin-bottom: 1.5rem;
	}

	/* ── Hero ── */
	.hero {
		position: relative;
		background: linear-gradient(135deg, #1e3a8a 0%, #4338ca 100%);
		border-radius: 1.5rem;
		margin: 1rem auto;
		max-width: 1000px;
		overflow: hidden;
		box-shadow: 0 20px 40px rgba(30, 58, 138, 0.18);
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 20% 30%, rgba(96, 165, 250, 0.25) 0%, transparent 50%),
			radial-gradient(circle at 80% 70%, rgba(129, 140, 248, 0.22) 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}

	/* Emojis flottants */
	.hero-emoji {
		position: absolute;
		font-size: 2.2rem;
		opacity: 0.15;
		pointer-events: none;
		user-select: none;
		animation: float 5s ease-in-out infinite;
		z-index: 0;
	}
	.hero-emoji-2 { animation-delay: 1s; }
	.hero-emoji-3 { animation-delay: 2s; }
	.hero-emoji-4 { animation-delay: 3s; }

	.hero-content {
		position: relative;
		padding: 3rem 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		max-width: 640px;
	}

	.title {
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		text-align: center;
		color: #ffffff;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
		letter-spacing: -0.02em;
		margin: 0;
		padding: 0;
		animation: fadeInUp 0.8s ease-out both;
	}

	.hero-subtitle {
		color: rgba(255, 255, 255, 0.92);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		margin: 0;
		animation: fadeInUp 0.8s ease-out 0.15s both;
	}

	.hero-tagline {
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.95rem;
		line-height: 1.6;
		text-align: center;
		margin: 0;
		animation: fadeInUp 0.8s ease-out 0.3s both;
	}

	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-8px); }
	}

	/* ── Sélecteur de profil ── */
	.profile-selector-section {
		text-align: center;
		padding: 1.75rem 1rem 0.5rem;
	}

	.profile-title {
		font-size: 1.1rem;
		color: var(--ink-2);
		font-weight: 700;
		margin-bottom: 1.1rem;
	}

	#profile-selector {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.9rem;
	}

	.profile-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		padding: 1.25rem 0.9rem;
		border-radius: var(--radius-md);
		border: 2px solid var(--border-color);
		background: var(--card-bg);
		cursor: pointer;
		font-family: inherit;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
		box-shadow: var(--shadow-sm);
	}

	.profile-card:hover,
	.profile-card:focus-visible {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
	}

	.profile-card:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 2px;
	}

	.profile-card--eleve:hover, .profile-card--eleve.profile-card--active { border-color: #3b82f6; }
	.profile-card--parent:hover, .profile-card--parent.profile-card--active { border-color: #10b981; }
	.profile-card--enseignant:hover, .profile-card--enseignant.profile-card--active { border-color: #7c3aed; }

	.profile-card--active {
		box-shadow: var(--shadow-md);
	}

	.profile-icon {
		font-size: 1.9rem;
		line-height: 1;
	}

	.profile-name {
		font-weight: 700;
		font-size: 0.98rem;
		color: var(--text);
	}

	.profile-desc {
		font-size: 0.78rem;
		color: var(--ink-3);
		line-height: 1.35;
	}

	/* ── Accès rapides ── */
	.quick-links-section {
		margin-top: 2.25rem;
	}

	.quick-links-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}

	.quick-link-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		height: 100%;
		padding: 1rem 0.5rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.quick-link-card:hover,
	.quick-link-card:focus-visible {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: var(--primary);
	}

	.quick-link-card:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 2px;
	}

	.qlc-icon {
		font-size: 1.6rem;
	}

	.qlc-label {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--text);
	}

	.qlc-desc {
		font-size: 0.72rem;
		color: var(--ink-3);
		text-align: center;
	}

	/* ── Recherche ── */
	.search-section {
		margin-top: 2.5rem;
	}

	/*
	 * Le CSS de src/styles/search.css est importé dans un <style> scopé de
	 * Layout.astro : Astro préfixe alors ses sélecteurs avec un attribut
	 * data-astro-cid-* que seul le template de Layout.astro reçoit — jamais
	 * les éléments rendus par le composant React Search.tsx. Résultat : ce
	 * fichier ne s'applique nulle part sur le site (vérifié identique sur
	 * /5eme). On ne touche pas à Search.tsx ni à search.css (autres
	 * composants) : on redonne ici un style fonctionnel à l'instance de la
	 * page d'accueil uniquement, via :global() scopé à .home-search-wrap.
	 */
	.home-search-wrap :global(.search-container) {
		position: static;
		top: auto;
		z-index: auto;
		width: 100%;
		background: transparent;
		padding: 0;
		margin-bottom: 0;
		border-bottom: none;
		backdrop-filter: none;
		box-shadow: none;
	}

	.home-search-wrap :global(.search-wrapper) {
		position: relative;
		display: flex;
		align-items: center;
		max-width: 640px;
		margin: 0 auto;
		padding: 0;
	}

	.home-search-wrap :global(.search-icon) {
		position: absolute;
		left: 1.1rem;
		color: var(--primary);
		pointer-events: none;
		z-index: 1;
	}

	.home-search-wrap :global(.search-input) {
		width: 100%;
		padding: 0.9rem 3rem 0.9rem 2.75rem;
		font-size: 1rem;
		font-weight: 400;
		border: 2px solid var(--border-color);
		border-radius: 2rem;
		background: var(--card-bg);
		color: var(--text);
		box-shadow: var(--shadow-sm);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.home-search-wrap :global(.search-input::placeholder) {
		color: var(--ink-3);
	}

	.home-search-wrap :global(.search-input:focus) {
		outline: none;
		border-color: var(--primary);
		box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
	}

	.home-search-wrap :global(.search-input:hover:not(:focus)) {
		border-color: var(--primary);
	}

	.home-search-wrap :global(.search-clear) {
		position: absolute;
		right: 1rem;
		background: var(--border-color);
		border: none;
		border-radius: 50%;
		width: 26px;
		height: 26px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--ink-3);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.home-search-wrap :global(.search-clear:hover) {
		background: var(--primary);
		color: white;
	}

	.home-search-wrap :global(.search-results) {
		position: absolute;
		top: calc(100% + 0.6rem);
		left: 0;
		right: 0;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		box-shadow: var(--shadow-md);
		max-height: 420px;
		overflow-y: auto;
		z-index: 50;
	}

	.home-search-wrap :global(.search-result-item) {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.1rem;
		border-bottom: 1px solid var(--border-color);
		text-decoration: none;
		color: inherit;
		transition: background 0.15s ease;
	}

	.home-search-wrap :global(.search-result-item:hover) {
		background: var(--background);
	}

	.home-search-wrap :global(.search-result-item:last-child) {
		border-bottom: none;
	}

	.home-search-wrap :global(.result-level) {
		flex-shrink: 0;
		background: var(--primary);
		color: white;
		padding: 0.3rem 0.7rem;
		border-radius: 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
	}

	.home-search-wrap :global(.result-content) {
		flex: 1;
		min-width: 0;
	}

	.home-search-wrap :global(.result-title) {
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 0.25rem 0;
		line-height: 1.35;
	}

	.home-search-wrap :global(.result-description) {
		font-size: 0.82rem;
		color: var(--ink-3);
		margin: 0;
		line-height: 1.45;
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	.home-search-wrap :global(.no-results) {
		padding: 2rem 1.25rem;
		text-align: center;
		color: var(--ink-3);
		font-style: italic;
	}

	@media (max-width: 480px) {
		.home-search-wrap :global(.search-input) {
			font-size: 0.92rem;
			padding: 0.8rem 2.75rem 0.8rem 2.5rem;
		}
		.home-search-wrap :global(.search-icon) {
			left: 0.9rem;
		}
	}

	/* ── Choix du niveau ── */
	.level-section {
		margin-top: 2.5rem;
	}

	.level-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.level-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 2rem 1.25rem;
		background: var(--card-bg);
		border-radius: var(--radius-lg);
		border-top: 4px solid transparent;
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.level-card:hover,
	.level-card:focus-visible {
		transform: translateY(-5px);
		box-shadow: var(--shadow-md);
	}

	.level-card:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 2px;
	}

	.level-card--5eme { border-top-color: #3B82F6; }
	.level-card--4eme { border-top-color: #10B981; }
	.level-card--3eme { border-top-color: #F97316; }

	.level-badge {
		font-size: 2.75rem;
		font-weight: 800;
		line-height: 1;
	}

	.level-badge-suffix {
		font-size: 1.3rem;
		font-weight: 700;
		margin-left: 0.1rem;
	}

	.level-card--5eme .level-badge { color: #3B82F6; }
	.level-card--4eme .level-badge { color: #10B981; }
	.level-card--3eme .level-badge { color: #F97316; }

	.level-card-title {
		font-size: 1.1rem;
		color: var(--text);
		margin-top: 0.6rem;
	}

	.level-card-desc {
		margin-top: 0.5rem;
		color: var(--ink-2);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.level-card-stat {
		margin-top: 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-3);
		background: var(--background);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		padding: 0.25rem 0.75rem;
	}

	.level-card-cta {
		margin-top: 1.1rem;
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--primary);
	}

	/* ── Brevet & Orientation ── */
	.showcase-section {
		margin-top: 2.5rem;
	}

	.showcase-eyebrow {
		text-align: center;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-3);
		margin-bottom: 0.75rem;
	}

	.showcase-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.showcase-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.5rem;
		border-radius: var(--radius-lg);
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--border-color);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.showcase-card:hover,
	.showcase-card:focus-visible {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
	}

	.showcase-card:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 2px;
	}

	.showcase-card--brevet {
		background: #fff7ed;
		border-color: #fed7aa;
	}

	.showcase-card--orientation {
		background: #eef2ff;
		border-color: #c7d2fe;
	}

	.showcase-icon {
		font-size: 1.9rem;
	}

	.showcase-title {
		font-size: 1.15rem;
		margin-top: 0.6rem;
		color: var(--text);
	}

	.showcase-card--brevet .showcase-title { color: #9a3412; }
	.showcase-card--orientation .showcase-title { color: #3730a3; }

	.showcase-desc {
		margin-top: 0.5rem;
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--ink-2);
	}

	.showcase-cta {
		margin-top: 1rem;
		font-weight: 700;
		font-size: 0.88rem;
	}

	.showcase-card--brevet .showcase-cta { color: #ea580c; }
	.showcase-card--orientation .showcase-cta { color: #4338ca; }

	/* ── Quiz ── */
	.quiz-section {
		margin-top: 3rem;
	}

	/* ── Intro ── */
	.intro-section {
		background: var(--card-bg);
		padding: 2rem;
		border-radius: var(--radius-lg);
		margin-top: 3rem;
		box-shadow: var(--shadow-sm);
	}

	.intro-section h2 {
		color: var(--primary-dark);
		margin-bottom: 1rem;
		font-size: 1.8rem;
		text-align: center;
	}

	.intro-text {
		color: var(--ink-2);
		line-height: 1.8;
		margin-bottom: 1rem;
		font-size: 1.05rem;
	}

	/* ── Présentation ── */
	.presentation {
		max-width: 800px;
		margin: 3rem auto 0;
		padding: 2rem;
		background: var(--card-bg);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}

	.presentation h2 {
		color: var(--primary-dark);
		margin-bottom: 1rem;
		font-size: 1.8rem;
		text-align: center;
	}

	.presentation-content {
		margin-top: 1.5rem;
	}

	.presentation-lead {
		color: var(--ink-2);
		line-height: 1.7;
		margin: 1.25rem 0 0.75rem;
	}

	.benefits-list, .approach-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
		display: grid;
		gap: 0.75rem;
	}

	.benefits-list li, .approach-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.9rem 1rem;
		background: var(--background);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		line-height: 1.55;
		color: var(--text);
		font-size: 0.92rem;
	}

	.list-card-icon {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		background: var(--primary);
		color: white;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.signature {
		font-family: 'Brush Script MT', cursive;
		font-size: 2rem;
		color: var(--primary);
		text-align: right;
		margin-top: 1.5rem;
		font-weight: bold;
	}

	/* ── Points forts ── */
	.program-highlights {
		margin-top: 4rem;
	}

	.program-highlights h2 {
		color: var(--primary-dark);
		margin-bottom: 2rem;
		font-size: 1.8rem;
		text-align: center;
	}

	.highlights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.highlight-card {
		background: var(--card-bg);
		padding: 1.5rem;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	.highlight-card h3 {
		color: var(--primary);
		margin-bottom: 1rem;
		font-size: 1.25rem;
		border-bottom: 2px solid var(--primary);
		padding-bottom: 0.5rem;
	}

	.highlight-card ul {
		list-style: none;
		padding-left: 0;
	}

	.highlight-card li {
		position: relative;
		padding-left: 1.4rem;
		margin-bottom: 0.75rem;
		line-height: 1.55;
		color: var(--text);
		font-size: 0.92rem;
	}

	.highlight-card li::before {
		content: "•";
		position: absolute;
		left: 0;
		color: var(--primary);
		font-weight: bold;
	}

	/* ── Méthodologie ── */
	.methodology {
		margin-top: 4rem;
	}

	.methodology h2 {
		color: var(--primary-dark);
		margin-bottom: 2rem;
		font-size: 1.8rem;
		text-align: center;
	}

	.methodology-content p {
		text-align: center;
		max-width: 800px;
		margin: 0 auto 2rem;
		color: var(--ink-2);
		line-height: 1.8;
	}

	.methodology-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 1.5rem;
	}

	.methodology-item {
		background: var(--card-bg);
		padding: 1.5rem;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
		transition: transform 0.25s ease;
	}

	.methodology-item:hover {
		transform: translateY(-4px);
	}

	.methodology-item h3 {
		color: var(--primary);
		margin-bottom: 0.75rem;
		font-size: 1.1rem;
	}

	.methodology-item p {
		color: var(--ink-2);
		line-height: 1.6;
		font-size: 0.92rem;
	}

	/* ── Ressources ── */
	.resources-section {
		margin-top: 4rem;
		margin-bottom: 3rem;
	}

	.resources-section h2 {
		color: var(--primary-dark);
		margin-bottom: 1rem;
		font-size: 1.8rem;
		text-align: center;
	}

	.resources-intro {
		text-align: center;
		max-width: 800px;
		margin: 0 auto 2rem;
		color: var(--ink-2);
		line-height: 1.8;
	}

	.resources-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 1.5rem;
	}

	.resource-card {
		background: var(--card-bg);
		padding: 1.5rem;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
		transition: transform 0.25s ease;
		display: flex;
		flex-direction: column;
	}

	.resource-card:hover {
		transform: translateY(-4px);
	}

	.resource-card h3 {
		color: var(--primary);
		margin-bottom: 0.75rem;
		font-size: 1.1rem;
	}

	.resource-card p {
		color: var(--ink-2);
		line-height: 1.6;
		margin-bottom: 1.25rem;
		flex-grow: 1;
		font-size: 0.92rem;
	}

	.resource-link {
		display: inline-block;
		padding: 0.7rem 1.1rem;
		background: var(--primary);
		color: white;
		text-decoration: none;
		border-radius: 0.5rem;
		transition: background 0.2s ease;
		font-size: 0.88rem;
		text-align: center;
	}

	.resource-link:hover {
		background: var(--primary-dark);
	}

	/* ── Liens utiles ── */
	.useful-links-section {
		margin-top: 2rem;
		text-align: center;
	}

	.useful-links-title {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-3);
		margin-bottom: 0.9rem;
	}

	.useful-links-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.useful-link-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		padding: 0.9rem 0.5rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		text-decoration: none;
		transition: transform 0.2s ease, border-color 0.2s ease;
		box-shadow: var(--shadow-sm);
	}

	.useful-link-card:hover,
	.useful-link-card:focus-visible {
		transform: translateY(-3px);
		border-color: var(--primary);
	}

	.useful-link-card:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 2px;
	}

	.useful-link-logo {
		height: 44px;
		width: auto;
		object-fit: contain;
	}

	.useful-link-name {
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--primary-dark);
		text-align: center;
		line-height: 1.2;
	}

	.useful-link-sub {
		font-size: 0.66rem;
		color: var(--ink-3);
	}

	/* ── Dark mode (nouveaux blocs) ── */
	:global([data-theme="dark"]) .profile-card,
	:global([data-theme="dark"]) .quick-link-card,
	:global([data-theme="dark"]) .level-card,
	:global([data-theme="dark"]) .useful-link-card {
		border-color: var(--border-color);
	}

	:global([data-theme="dark"]) .level-card-stat,
	:global([data-theme="dark"]) .benefits-list li,
	:global([data-theme="dark"]) .approach-list li {
		background: var(--background);
		border-color: var(--border-color);
	}

	:global([data-theme="dark"]) .showcase-card--brevet {
		background: #2a1a0f;
		border-color: #7c2d12;
