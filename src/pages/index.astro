<script>
	// Léger parallaxe du hero — désactivé si prefers-reduced-motion, et
	// seulement actif pendant que le hero est visible (perf).
	const heroEl = document.querySelector<HTMLElement>('.hero');
	const blobs = document.querySelectorAll<HTMLElement>('.hero-blob');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (heroEl && blobs.length && !prefersReducedMotion) {
		let ticking = false;
		let heroVisible = true;

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				if (heroVisible) {
					const offset = window.scrollY * 0.08;
					blobs.forEach((blob, i) => {
						blob.style.transform = `translateY(${i % 2 === 0 ? offset : -offset}px)`;
					});
				}
				ticking = false;
			});
		};

		const observer = new IntersectionObserver((entries) => {
			heroVisible = entries[0]?.isIntersecting ?? false;
		}, { threshold: 0 });

		observer.observe(heroEl);
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>
