---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = `Dans cette séquence, les élèves analysent l'environnement d'un objet ou système technique en identifiant ses interacteurs extérieurs, puis apprennent à choisir un OST selon plusieurs critères grâce à une démarche multicritère et raisonnée. Les supports d'étude sont la trottinette électrique et le vélo à assistance électrique (VAE) :`;

const activities = [
  {
    title: "L’OST dans son environnement : interacteurs, choix raisonné et développement durable",
    description: "Comment les interacteurs extérieurs influencent-ils l'utilisation et le fonctionnement d'une trottinette électrique ?"
  },
  {
    title: "Comparer pour mieux choisir",
    description: "Comment choisir le VAE le plus adapté au libre-service qui correspondrait le mieux aux attentes de la municipalité ?"
  }
];

const level = "3eme";
---

<ClassLayout title="Séquence 7 – L’OST idéal : Trottinette électrique et VAE - 3ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 7 – L’OST idéal : Trottinette électrique et VAE</h1>

  <SequencePresentation
    title="La trottinette électrique et le VAE : analyser l'environnement et choisir selon des critères"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment identifier les interacteurs d'un objet technique et choisir le modèle le mieux adapté à un besoin ?"
  />

  <ActivityLinks sequenceNumber={7} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
