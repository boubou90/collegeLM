---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = `Dans cette séquence, les élèves analysent l'environnement d'un objet ou système technique en identifiant ses interacteurs extérieurs, puis apprennent à choisir un OST selon plusieurs critères grâce à une démarche multicritère. Le support d'étude est le Raspberry Pi 5 :`;

const activities = [
  {
    title: "Le Raspberry Pi 5 : interacteurs, choix raisonné et mesure de performance",
    description: "Comment identifier les interacteurs extérieurs d'un objet technique et analyser ses interactions avec son environnement ?"
  },
  {
    title: "Comparer pour mieux choisir",
    description: "Comment choisir entre plusieurs modèles d'un même objet technique en utilisant une démarche multicritère ?"
  }
];

const level = "3eme";
---

<ClassLayout title="Séquence 6 – L'OST idéal : L'ordinateur Raspberry Pi - 3ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 6 – L'OST idéal : L'ordinateur Raspberry Pi</h1>

  <SequencePresentation
    title="Le Raspberry Pi 5 : analyser l'environnement et choisir selon des critères"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment identifier les interacteurs d'un objet technique et choisir le modèle le mieux adapté à un besoin ?"
  />

  <ActivityLinks sequenceNumber={6} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
