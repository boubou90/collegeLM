---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = `Dans cette séquence, les élèves étudient l'évolution des objets de communication, du téléphone fixe au smartphone connecté. Ils identifient les innovations de rupture, analysent les liens entre découvertes scientifiques et évolutions technologiques, et s'interrogent sur les effets de l'intelligence artificielle sur la société :`;

const activities = [
  {
    title: "Lancement de séquence",
    description: "Observer et questionner l'évolution du téléphone jusqu'au smartphone d'aujourd'hui"
  },
  {
    title: "Du téléphone au smartphone",
    description: "Identifier les innovations de rupture et les contraintes sociétales dans la lignée des objets de communication"
  },
  {
    title: "L'IA dans notre poche",
    description: "Analyser les usages, les biais et les incidences sociétales des intelligences artificielles intégrées au smartphone"
  }
];

const level = "3eme";
---

<ClassLayout title="Séquence 2 – Le smartphone, entre innovation et responsabilité - 3ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 2 – Le smartphone, entre innovation et responsabilité</h1>

  <SequencePresentation
    title="Comprendre l'évolution des objets de communication et les responsabilités liées à l'IA"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment les innovations technologiques transforment-elles les objets de communication et quelles conséquences peuvent-elles avoir sur la société ?"
  />

  <ActivityLinks sequenceNumber={2} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
