---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = `Dans cette séquence, les élèves explorent le smartphone comme système de création, de stockage et de partage de fichiers numériques. Ils comprennent comment les données circulent dans les réseaux et sont stockées dans des infrastructures numériques, avant d'analyser les incidences du stockage et de la circulation massive des données :`;

const activities = [
  {
    title: "Data : le poids caché de nos vies numériques",
    description: "Comment des fichiers qui ne pèsent (presque) rien dans nos téléphones peuvent-ils avoir un poids énorme pour la société ?"
  }
];

const level = "3eme";
---

<ClassLayout title="Séquence 5 – Datas : Le poids caché de nos vies numériques - 3ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 5 – Datas : Le poids caché de nos vies numériques</h1>

  <SequencePresentation
    title="Du smartphone aux centres de données : quand nos fichiers voyagent dans le monde entier"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment des fichiers qui ne pèsent (presque) rien dans nos téléphones peuvent-ils avoir un poids énorme pour la société ?"
  />

  <ActivityLinks sequenceNumber={5} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
