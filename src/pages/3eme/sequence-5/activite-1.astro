  }

  .multiple-carte.accent {
    background: #dbeafe;
    border-color: #93c5fd;
  }

  .multiple-symbole {
    font-size: 1.4rem;
    font-weight: 900;
    color: #1e3a8a;
    font-family: monospace;
  }

  .multiple-nom {
    font-size: 0.75rem;
    font-weight: 600;
    color: #334155;
    margin: 0.2rem 0;
  }

  .multiple-val {
    font-size: 0.72rem;
    color: #64748b;
  }

  /* ── Facteurs ── */
  .facteurs-liste {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0.75rem 0 1rem;
  }

  .facteur-item {
    padding: 0.5rem 0.9rem;
    background: #f8fafc;
    border-left: 3px solid #1e3a8a;
    border-radius: 0 0.4rem 0.4rem 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* ── Tailles des fichiers ── */
  .tailles-grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .taille-carte {
    border-radius: 0.5rem;
    padding: 0.9rem;
    text-align: center;
    border: 1px solid;
  }

  .taille-carte.image { background: #fef3c7; border-color: #fcd34d; }
  .taille-carte.son   { background: #f0fdf4; border-color: #86efac; }
  .taille-carte.video { background: #fdf2f8; border-color: #f0abfc; }

  .taille-icone { font-size: 1.75rem; margin-bottom: 0.3rem; }

