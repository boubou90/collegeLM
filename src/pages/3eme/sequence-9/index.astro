---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = `Dans cette séquence, les élèves découvrent comment un vélo à assistance électrique (VAE) connecté collecte, représente et traite ses données de trajet. Ils apprennent le vocabulaire des données, la représentation binaire et le code ASCII, puis exploitent un jeu de données réel avec LibreOffice Calc :`;

const activities = [
  {
    title: "La vie du VAE racontée par ses données",
    description: "Comment un VAE collecte-t-il, représente-t-il et traite-t-il ses données pour rendre compte de son fonctionnement ?"
  }
];

const level = "3eme";
---

<ClassLayout title="Séquence 9 – La vie du VAE racontée par ses données - 3ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 9 – La vie du VAE racontée par ses données</h1>

  <SequencePresentation
    title="Le VAE connecté : structurer et traiter ses données"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment un VAE collecte-t-il, représente-t-il et traite-t-il ses données pour rendre compte de son fonctionnement ?"
  />

  <ActivityLinks sequenceNumber={9} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
