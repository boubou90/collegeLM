---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import ActivitySection from '../../../components/ActivitySection.astro';
import BackButton from '../../../components/BackButton.astro';

const level = "3eme";
const documents = [
  {
    title: "Activité 1 — Les impacts du numérique sur la société et les métiers",
    pdfUrl: "/documents/3eme/sequence-4/activite-1/activite-1.pdf"
  },
  {
    title: "Fiche ressource — Fonctionnement du robot livreur autonome",
    pdfUrl: "/documents/3eme/sequence-4/activite-1/Fiche Ressource - IA et Robotique - Chaîne d_information.pdf"
  }
];
---

<ClassLayout title="Activité 1 - Séquence 4 - 3ème" level={level}>
  <BackButton href={`/${level}/sequence-4`} />
  <h1>Séquence 4 – Comprendre l'impact du numérique sur la société et les métiers · Activité 1</h1>

  <ActivitySection
    title="Les impacts du numérique sur la société et les métiers"
    description="Durée : 1h30 — Comment le développement de l'informatique et d'Internet a-t-il permis de transformer le métier de chauffeur-livreur ? À travers la comparaison de deux portraits de livreurs, tu exploreras comment le numérique transforme les outils, les méthodes de travail et certains métiers."
    documents={documents}
    activityNumber={1}
    totalActivities={1}
    sequenceHref="/3eme/sequence-4"
    sequenceLabel="Séquence 4 – Comprendre l'impact du numérique sur la société et les métiers"
    retenir={{
      definitions: [
        { term: "Application (logiciel)", def: "Programme installé ou accessible sur un appareil pour réaliser une tâche spécifique." },
        { term: "Objet connecté", def: "Objet équipé de capteurs et capable d'échanger des données via un réseau." },
        { term: "Base de données", def: "Ensemble organisé d'informations enregistrées et réutilisables par un système informatique." },
        { term: "Microcontrôleur", def: "Composant électronique programmable qui reçoit, traite des données et pilote les actionneurs d'un système." },
        { term: "Intelligence artificielle (IA)", def: "Système informatique capable d'analyser des données pour identifier des éléments et participer à la prise de décision." },
        { term: "Stratégie numérique", def: "Ensemble des choix technologiques d'une organisation pour rester compétitive grâce au numérique." },
      ],
      points: [
        "Le numérique transforme les outils et les méthodes de travail dans les métiers.",
        "Les données peuvent être collectées, transmises, stockées et traitées automatiquement.",
        "Les capteurs permettent à un système technique d'obtenir des informations sur son environnement.",
        "Un système automatisé peut traiter ces informations et agir sans intervention humaine.",
        "L'IA peut participer à l'analyse des données et à la prise de décision.",
        "Ces évolutions peuvent transformer les métiers et la société.",
      ]
    }}
  >
    <div class="activity-content">

      <!-- ══════════ COMPÉTENCES ══════════ -->
      <div class="competences-box">
        <span class="competences-titre">Compétences travaillées</span>
        <span class="competence-tag">OST1 — Liens entre usages et évolutions technologiques</span>
        <span class="competence-tag">T2 — Usages et impacts sociétaux du numérique</span>
        <span class="competence-tag">OST15 — Argumentation sur la stratégie numérique</span>
        <span class="competence-tag cps">CPS C1.2 — Penser de façon critique</span>
      </div>

      <!-- ══════════ OBJECTIF ══════════ -->
      <div class="section-bloc objectif">
        <h3>🎯 Objectif</h3>
        <p>Dans cette activité, tu vas comprendre <strong>comment le développement de l'informatique et d'Internet a transformé le métier de chauffeur-livreur</strong>.</p>
        <p>Tu observeras que le numérique modifie progressivement les outils, les méthodes de travail et certains métiers — et tu réfléchiras aux conséquences de ces évolutions pour les travailleurs et la société.</p>
        <div class="problematique-box">
          <strong>Problématique :</strong> Comment le développement de l'informatique et d'Internet a-t-il permis de transformer le métier de chauffeur-livreur ?
        </div>
      </div>

      <!-- ══════════ HIER / AUJOURD'HUI ══════════ -->
      <div class="section-bloc">
        <h3>🚚 Du métier de chauffeur-livreur d'hier à aujourd'hui</h3>
        <p>L'activité te présente deux livreurs travaillant dans la même entreprise à deux époques différentes.</p>

        <div class="comparaison-grille">
          <div class="comparaison-colonne hier">
            <div class="comparaison-titre">Hier — Marcel (1995)</div>
            <ul>
              <li>📄 Bons de livraison papier</li>
              <li>🗺️ Carte routière</li>
              <li>📝 Carnet de livraison</li>
              <li>☎️ Cabine téléphonique</li>
              <li>✍️ Récapitulatif rempli à la main</li>
              <li>🖥️ Saisie manuelle des données</li>
            </ul>
            <p class="comparaison-note">Les informations circulent lentement et manuellement.</p>
          </div>
          <div class="comparaison-colonne maintenant">
            <div class="comparaison-titre">Aujourd'hui — Inès</div>
            <ul>
              <li>📱 Application smartphone</li>
              <li>🛰️ GPS et optimisation automatique du trajet</li>
              <li>🚛 Camion connecté</li>
              <li>📟 Tablette</li>
              <li>✍️ Signature électronique</li>
              <li>☁️ Transmission automatique des données</li>
            </ul>
            <p class="comparaison-note">Les informations sont transmises automatiquement, en temps réel, à tous les services.</p>
          </div>
        </div>

        <p class="section-info">Le numérique permet désormais de <strong>communiquer, calculer, suivre et transmettre automatiquement des informations</strong>, transformant profondément la manière de travailler.</p>
      </div>

      <!-- ══════════ OUTILS NUMÉRIQUES ══════════ -->
      <div class="section-bloc">
        <h3>💻 Les principaux outils numériques</h3>
        <p>Pour bien comprendre l'activité, voici les quatre types d'outils numériques qui apparaissent dans les situations étudiées :</p>
        <div class="outils-grille">
          <div class="outil-carte">
            <div class="outil-icone">📱</div>
            <div class="outil-nom">Application</div>
            <div class="outil-def">Programme installé ou accessible sur un appareil pour réaliser une tâche (gérer les commandes, calculer un itinéraire, notifier un client…).</div>
          </div>
          <div class="outil-carte">
            <div class="outil-icone">🔗</div>
            <div class="outil-nom">Objet connecté</div>
            <div class="outil-def">Objet équipé de capteurs, capable d'échanger des données via un réseau. Exemple : le smartphone du livreur qui transmet sa position GPS.</div>
          </div>
          <div class="outil-carte">
            <div class="outil-icone">🗄️</div>
            <div class="outil-nom">Base de données</div>
            <div class="outil-def">Ensemble organisé d'informations enregistrées et réutilisables. Elle centralise toutes les données de livraison accessibles par tous les services.</div>
          </div>
          <div class="outil-carte">
            <div class="outil-icone">💾</div>
            <div class="outil-nom">Logiciel</div>
            <div class="outil-def">Programme permettant de réaliser une ou plusieurs tâches : ici, optimiser les tournées, analyser les performances ou planifier les livraisons.</div>
          </div>
        </div>
      </div>

      <!-- ══════════ DONNÉES ══════════ -->
      <div class="section-bloc">
        <h3>📊 Le numérique et les données</h3>
        <p>Les outils numériques ne servent pas seulement à communiquer : ils permettent surtout de <strong>travailler avec des données</strong>.</p>

        <div class="donnees-chaine">
          <div class="chaine-etape">📡<br><strong>Recueillir</strong><br><span>capteurs, GPS</span></div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-etape">📶<br><strong>Transmettre</strong><br><span>réseau Internet</span></div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-etape">🗄️<br><strong>Stocker</strong><br><span>base de données</span></div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-etape">⚙️<br><strong>Traiter</strong><br><span>logiciel, IA</span></div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-etape">✅<br><strong>Décider / Agir</strong><br><span>automatiquement</span></div>
        </div>

        <p class="section-info">Dans l'exemple du livreur : les données collectées (kilomètres parcourus, consommation, retards, itinéraires, suivi des colis) sont stockées puis traitées pour optimiser les tournées suivantes ou déclencher une alerte en temps réel.</p>
      </div>

      <!-- ══════════ ROBOT ══════════ -->
      <div class="section-bloc">
        <h3>🤖 Le robot livreur autonome</h3>
        <p>L'activité présente le robot <strong>TransLog</strong>, un robot livreur autonome capable de se déplacer sur les trottoirs pour livrer des colis. Pour fonctionner sans conducteur humain, il utilise la même chaîne que ci-dessus, mais de façon entièrement automatisée.</p>

        <h4>Ses capteurs collectent des informations sur l'environnement :</h4>
        <div class="capteurs-liste">
          <div class="capteur-item">
            <span class="capteur-icone">📷</span>
            <div>
              <strong>Caméras</strong><br>
              Fournissent des images de l'environnement, analysées par l'IA pour identifier les éléments (piétons, obstacles…).
            </div>
          </div>
          <div class="capteur-item">
            <span class="capteur-icone">📡</span>
            <div>
              <strong>Radar / Ultrasons</strong><br>
              Permettent de détecter les obstacles et de mesurer les distances pour éviter les collisions.
            </div>
          </div>
          <div class="capteur-item">
            <span class="capteur-icone">🛰️</span>
            <div>
              <strong>GPS</strong><br>
              Fournit la position du robot et lui permet de suivre l'itinéraire jusqu'à l'adresse de livraison.
            </div>
          </div>
        </div>

        <h4>Puis un microcontrôleur et une IA traitent ces informations :</h4>
        <div class="chaine-robot">
          <div class="robot-etape">
            <span class="robot-num">1</span>
            <div><strong>Microcontrôleur</strong><br>Reçoit et traite les données des capteurs en temps réel.</div>
          </div>
          <div class="robot-fleche">→</div>
          <div class="robot-etape">
            <span class="robot-num">2</span>
            <div><strong>IA</strong><br>Analyse les informations et identifie les éléments de l'environnement.</div>
          </div>
          <div class="robot-fleche">→</div>
          <div class="robot-etape">
            <span class="robot-num">3</span>
            <div><strong>Décision</strong><br>Le système choisit l'action adaptée à la situation.</div>
          </div>
          <div class="robot-fleche">→</div>
          <div class="robot-etape">
            <span class="robot-num">4</span>
            <div><strong>Action</strong><br>Le robot se déplace, ralentit, contourne ou s'arrête.</div>
          </div>
        </div>

        <div class="exemple-box">
          <strong>Exemple simple :</strong> le robot détecte un piéton grâce à ses caméras et radars → l'IA analyse l'image et identifie le piéton → le système décide de ralentir → le robot adapte son déplacement.
        </div>
      </div>

      <!-- ══════════ STRATÉGIE ══════════ -->
      <div class="section-bloc">
        <h3>🏢 Pourquoi utiliser le numérique dans une entreprise ?</h3>
        <p>Les choix technologiques d'une entreprise ne sont pas pris au hasard : ils répondent à une <strong>stratégie numérique</strong> visant à rester compétitive.</p>
        <div class="avantages-liste">
          <div class="avantage-item">🗺️ <strong>Optimiser les tournées</strong> — calcul automatique du meilleur itinéraire</div>
          <div class="avantage-item">⚡ <strong>Gagner du temps</strong> — itinéraires optimisés automatiquement</div>
          <div class="avantage-item">📦 <strong>Suivre les livraisons</strong> — position et statut en temps réel</div>
          <div class="avantage-item">🤖 <strong>Automatiser certaines tâches</strong> — notifications clients, rapports</div>
          <div class="avantage-item">📈 <strong>Améliorer l'efficacité</strong> — plus de colis livrés, moins d'erreurs</div>
          <div class="avantage-item">🏆 <strong>Rester compétitive</strong> — par rapport aux concurrents qui utilisent les mêmes technologies</div>
        </div>
      </div>

      <!-- ══════════ TRANSFORMATION MÉTIERS ══════════ -->
      <div class="section-bloc">
        <h3>⚠️ Le numérique transforme aussi les métiers</h3>
        <p>L'évolution numérique ne touche pas seulement les outils : elle modifie les métiers eux-mêmes.</p>
        <ul class="impacts-liste">
          <li>Certaines tâches <strong>disparaissent</strong> (saisie manuelle, lecture de cartes…).</li>
          <li>De nouvelles tâches <strong>apparaissent</strong> (maintenance des systèmes, gestion des données…).</li>
          <li>Certaines activités peuvent être <strong>automatisées</strong> par des robots ou des logiciels.</li>
          <li>Des métiers peuvent être <strong>transformés en profondeur</strong> ou, dans certains cas, remplacés.</li>
        </ul>
        <p class="section-info">L'activité te demande de réfléchir à ces conséquences — en pesant <strong>à la fois les avantages et les inconvénients</strong>. Il n'existe pas de réponse unique : l'enjeu est d'argumenter de façon critique et équilibrée.</p>
      </div>

    </div>
  </ActivitySection>
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }

  /* ── Compétences ── */
  .competences-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding: 0.75rem 1rem;
    background: #f0f4ff;
    border-radius: 0.5rem;
    border: 1px solid #c7d7f9;
  }

  .competences-titre {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: 100%;
  }

  .competence-tag {
    font-size: 0.78rem;
    font-weight: 600;
    color: #1e3a8a;
    background: #dbeafe;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }

  .competence-tag.cps {
    background: #ede9fe;
    color: #5b21b6;
  }

  /* ── Sections ── */
  .section-bloc {
    margin: 1.75rem 0;
  }

  .section-bloc h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1e3a8a;
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid #dbeafe;
  }

  .section-bloc h4 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #334155;
    margin: 1rem 0 0.5rem;
  }

  .section-info {
    margin-top: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: #f1f5fb;
    border-left: 3px solid #1e3a8a;
    border-radius: 0 0.4rem 0.4rem 0;
    font-size: 0.88rem;
    color: #1e3a8a;
    line-height: 1.6;
  }

  /* ── Objectif ── */
  .objectif {
    background: #f8faff;
    border: 1px solid #dbeafe;
    border-radius: 0.6rem;
    padding: 1rem 1.25rem;
  }

  .problematique-box {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    background: #1e3a8a;
    color: #fff;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ── Comparaison Hier / Aujourd'hui ── */
  .comparaison-grille {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1rem 0;
  }

  @media (max-width: 600px) {
    .comparaison-grille { grid-template-columns: 1fr; }
  }

  .comparaison-colonne {
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .comparaison-colonne.hier {
    background: #fef9f0;
    border: 1px solid #fcd34d;
  }

  .comparaison-colonne.maintenant {
    background: #f0fdf4;
    border: 1px solid #86efac;
  }

  .comparaison-titre {
    font-weight: 800;
    font-size: 0.9rem;
    color: #1e293b;
    margin-bottom: 0.6rem;
  }

  .comparaison-colonne ul {
