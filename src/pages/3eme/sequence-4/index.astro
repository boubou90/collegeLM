---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = `Dans cette séquence, les élèves découvrent comment le développement du numérique et d'Internet a transformé les métiers et la société. À travers la comparaison de deux portraits de livreurs — Marcel en 1995 et Inès aujourd'hui — ils analysent les outils numériques qui ont fait évoluer les pratiques professionnelles, et s'interrogent sur l'impact de l'intelligence artificielle sur l'emploi :`;

const activities = [
  {
    title: "Les impacts du numérique sur la société et les métiers",
    description: "Comment le développement de l'informatique et d'Internet a-t-il permis de transformer le métier de chauffeur-livreur ?"
  }
];

const level = "3eme";
---

<ClassLayout title="Séquence 4 – Comprendre l'impact du numérique sur la société et les métiers - 3ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 4 – Comprendre l'impact du numérique sur la société et les métiers</h1>

  <SequencePresentation
    title="Du livreur au robot : comment le numérique transforme les métiers"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment le développement de l'informatique et d'Internet a-t-il permis de transformer le métier de chauffeur-livreur ?"
  />

  <ActivityLinks sequenceNumber={4} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
