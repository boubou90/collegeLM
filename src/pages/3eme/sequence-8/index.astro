---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import SequencePresentation from '../../../components/SequencePresentation.astro';
import ActivityLinks from '../../../components/ActivityLinks.astro';
import BackButton from '../../../components/BackButton.astro';

const description = `Dans cette séquence, les élèves étudient le robot mBot pour comprendre comment il fonctionne (chaîne d'énergie, chaîne d'information) puis analysent les matériaux qui le composent et leur incidence sur l'environnement. Le support d'étude est le robot mBot :`;

const activities = [
  {
    title: "Les secrets d'un mBot",
    description: "Comment fonctionnent tous ces objets techniques ? Comment limiter l'accumulation des déchets ?"
  },
  {
    title: "Analyse fonctionnelle du robot mBot",
    description: "Comment le robot mBot fait-il pour transformer une information (distance, lumière…) en mouvement ?"
  },
  {
    title: "Analyse environnementale",
    description: "Pourquoi les concepteurs n'ont-ils pas fabriqué toutes les pièces du robot avec le même matériau ? Tous ces matériaux sont-ils bons pour l'environnement ?"
  }
];

const level = "3eme";
---

<ClassLayout title="Séquence 8 – Les secrets du mBot - 3ème" level={level}>
  <BackButton href={`/${level}`} />
  <h1>Séquence 8 – Les secrets du mBot</h1>

  <SequencePresentation
    title="Le robot mBot : comprendre son fonctionnement et analyser ses matériaux"
    description={description}
    activities={activities.map(a => a.description)}
    question="Comment fonctionnent tous ces objets techniques et comment limiter l'accumulation des déchets ?"
  />

  <ActivityLinks sequenceNumber={8} activities={activities} level={level} />
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }
</style>
