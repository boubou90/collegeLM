---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import ActivitySection from '../../../components/ActivitySection.astro';
import BackButton from '../../../components/BackButton.astro';

const level = "3eme";
const documents: { title: string; pdfUrl?: string; imageUrl?: string }[] = [
  {
    title: "Activité 2 — Analyse fonctionnelle du robot mBot",
    pdfUrl: "/documents/3eme/sequence-8/activite-2/activite-2.pdf"
  }
];
---

<ClassLayout title="Activité 2 - Séquence 8 - 3ème" level={level}>
  <BackButton href={`/${level}/sequence-8`} />
  <h1>Séquence 8 – Les secrets du mBot · Activité 2</h1>

  <ActivitySection
    title="Analyse fonctionnelle du robot mBot"
    description="Durée : 1h30 — Le robot mBot peut détecter son environnement et se déplacer tout seul. Mais comment fait-il pour transformer une information (distance, lumière…) en mouvement ? Cette activité te fait découvrir les mécanismes de transmission du mouvement et les constituants de la chaîne d'information du robot."
    documents={documents}
    activityNumber={2}
    totalActivities={3}
    sequenceHref="/3eme/sequence-8"
    sequenceLabel="Séquence 8 – Les secrets du mBot"
    retenir={{
      definitions: [
        { term: "Mécanisme de transmission", def: "Élément qui transmet (et parfois transforme) un mouvement d'une pièce à une autre, par exemple du moteur vers les roues." },
        { term: "Chaîne d'information", def: "Ensemble des fonctions qui permettent d'acquérir une information, de la traiter, puis de la communiquer." },
        { term: "Chaîne d'énergie", def: "Ensemble des fonctions qui permettent d'alimenter, distribuer, convertir et transmettre l'énergie jusqu'au mouvement." },
        { term: "Capteur", def: "Constituant qui mesure une grandeur physique (distance, lumière, présence d'une ligne noire…) et la transforme en information." },
        { term: "Microcontrôleur", def: "Constituant qui traite les informations reçues des capteurs et élabore les ordres envoyés à la chaîne d'énergie." },
      ],
      points: [
        "Le mBot possède des moteurs qui font tourner les roues, et plusieurs capteurs qui mesurent des grandeurs physiques (distance, lumière, ligne noire…).",
        "Trois mécanismes de transmission existent dans les systèmes techniques : engrenages, courroies, chaînes.",
        "La chaîne d'information : Acquérir → Traiter → Communiquer.",
        "La chaîne d'énergie : Alimenter → Distribuer → Convertir → Transmettre → mouvement.",
        "La chaîne d'information envoie des ordres vers la chaîne d'énergie : les deux chaînes fonctionnent ensemble.",
      ]
    }}
  >
    <div class="activity-content">

      <!-- ══════════ COMPÉTENCES ══════════ -->
      <div class="competences-box">
        <span class="competences-titre">Compétences travaillées</span>
        <span class="competence-tag">T6 — Chaîne d'énergie</span>
        <span class="competence-tag">T8 — Fonctions, solutions et constituants de la chaîne d'information</span>
        <span class="competence-tag">SFC1 — Décrire la structure et le comportement d'un OST</span>
        <span class="competence-tag">SFC11 — Chaîne d'énergie (schéma bloc)</span>
        <span class="competence-tag">SFC13 — Chaîne d'information</span>
        <span class="competence-tag">SFC1d — Mécanismes de transmission</span>
        <span class="competence-tag">SFC1i — Fonctions des constituants</span>
      </div>

      <!-- ══════════ OBJECTIF / SITUATION ══════════ -->
      <div class="section-bloc objectif">
        <h3>🎯 Situation</h3>
        <p>Le robot <strong>mBot</strong> peut détecter son environnement et se déplacer tout seul, sans que personne ne le télécommande.</p>
        <div class="problematique-box">
          <strong>Problématique :</strong> Comment le robot mBot fait-il pour transformer une information (distance, lumière…) en mouvement ?
        </div>
        <p>Le mBot possède des <strong>moteurs</strong> qui permettent de faire tourner les roues afin de se déplacer, et plusieurs <strong>capteurs</strong> capables de mesurer des grandeurs physiques comme la distance, la lumière, ou la présence d'une ligne noire.</p>
      </div>

      <!-- ══════════ MOTEURS ET TRANSMISSION ══════════ -->
      <div class="section-bloc">
        <h3>⚙️ Le rôle des moteurs et des mécanismes de transmission</h3>
        <p>Un moteur transforme l'énergie électrique en mouvement de rotation, mais ce mouvement doit ensuite être <strong>transmis</strong> jusqu'aux roues. C'est le rôle d'un <strong>mécanisme de transmission</strong> : transmettre, et parfois transformer, un mouvement d'une pièce à une autre.</p>
        <p>Trois mécanismes de transmission sont à connaître :</p>
        <div class="categories-grille">
          <div class="categorie-carte usager">
            <div class="categorie-icone">⚙️</div>
            <div class="categorie-titre">Engrenages</div>
            <div class="categorie-desc">Deux roues dentées qui s'engrènent pour transmettre un mouvement de rotation.</div>
          </div>
          <div class="categorie-carte donnees">
            <div class="categorie-icone">➰</div>
            <div class="categorie-titre">Courroie</div>
            <div class="categorie-desc">Une bande souple qui relie deux poulies pour transmettre un mouvement à distance.</div>
          </div>
          <div class="categorie-carte objet">
            <div class="categorie-icone">🔗</div>
            <div class="categorie-titre">Chaîne</div>
            <div class="categorie-desc">Une suite de maillons articulés qui relie deux pignons dentés.</div>
          </div>
        </div>
        <p class="section-info">La fiche d'activité te montre trois images de mécanismes : à toi de reconnaître lequel est un engrenage, lequel est une courroie et lequel est une chaîne.</p>
      </div>

      <!-- ══════════ CAPTEURS ══════════ -->
      <div class="section-bloc">
        <h3>📡 Le rôle des capteurs</h3>
        <p>Un <strong>capteur</strong> mesure une grandeur physique de l'environnement et la transforme en information utilisable par le robot. Le mBot utilise notamment des capteurs de <strong>distance</strong>, de <strong>lumière</strong>, et de <strong>détection d'une ligne noire</strong> (pour suivre un tracé au sol).</p>
      </div>

      <!-- ══════════ CHAÎNE D'INFORMATION ══════════ -->
      <div class="section-bloc">
        <h3>🧠 La chaîne d'information</h3>
        <p>La <strong>chaîne d'information</strong> décrit comment un système traite les informations qu'il reçoit, avant de donner des ordres :</p>
        <div class="chaine-schema">
          <div class="chaine-etape">INFORMATIONS</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-bloc acquerir">ACQUÉRIR</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-bloc traiter">TRAITER</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-bloc communiquer">COMMUNIQUER</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-etape">ORDRES</div>
        </div>
        <ul class="demarche-liste">
          <li><strong>Acquérir</strong> : les capteurs mesurent une grandeur physique (distance, lumière…) et la transforment en information.</li>
          <li><strong>Traiter</strong> : le <strong>microcontrôleur</strong> analyse les informations reçues et décide de la réponse à apporter.</li>
          <li><strong>Communiquer</strong> : le système transmet un signal à l'utilisateur (afficheur, voyant…) et/ou envoie un ordre vers la chaîne d'énergie.</li>
        </ul>
        <p class="section-info">Une interface entre l'humain et la machine (IHM) — boutons, afficheurs… — permet aussi à l'utilisateur d'échanger avec le robot.</p>
      </div>

      <!-- ══════════ CHAÎNE D'ÉNERGIE ══════════ -->
      <div class="section-bloc">
        <h3>🔋 La chaîne d'énergie</h3>
        <p>La <strong>chaîne d'énergie</strong> décrit comment l'énergie est transformée, étape par étape, jusqu'à produire un mouvement :</p>
        <div class="chaine-schema">
          <div class="chaine-etape">ÉNERGIE</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-bloc energie">ALIMENTER</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-bloc energie">DISTRIBUER</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-bloc energie">CONVERTIR</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-bloc energie">TRANSMETTRE</div>
          <div class="chaine-fleche">→</div>
          <div class="chaine-etape">MOUVEMENT</div>
        </div>
        <ul class="demarche-liste">
          <li><strong>Alimenter</strong> : fournir l'énergie électrique (ex : des piles).</li>
          <li><strong>Distribuer</strong> : acheminer l'énergie au bon endroit (ex : des câbles).</li>
          <li><strong>Convertir</strong> : transformer l'énergie électrique en énergie mécanique (ex : le moteur).</li>
          <li><strong>Transmettre</strong> : transmettre ce mouvement jusqu'aux roues, grâce à un <strong>mécanisme de transmission</strong> (engrenage, courroie ou chaîne).</li>
        </ul>
      </div>

      <!-- ══════════ ACTIONNEURS ══════════ -->
      <div class="section-bloc">
        <h3>🦾 Le rôle des actionneurs</h3>
        <p>Un <strong>actionneur</strong> est le constituant qui réalise concrètement une action commandée par le microcontrôleur : dans le mBot, c'est par exemple un moteur qui fait tourner une roue, ou une LED qui s'allume.</p>
      </div>

      <!-- ══════════ LIEN ENTRE LES DEUX CHAÎNES ══════════ -->
      <div class="section-bloc">
        <h3>🔗 Le lien entre chaîne d'information et chaîne d'énergie</h3>
        <p>Ces deux chaînes ne fonctionnent pas séparément : la chaîne d'information <strong>acquiert</strong> et <strong>traite</strong> des informations, puis envoie des <strong>ordres</strong> vers la chaîne d'énergie, qui les transforme en <strong>mouvement</strong>. C'est cette coopération qui permet au mBot de réagir seul à son environnement — par exemple, ralentir en détectant un obstacle avec son capteur de distance.</p>
      </div>

      <!-- ══════════ RESSOURCES ══════════ -->
      <div class="section-bloc">
        <h3>📚 Ressources complémentaires</h3>
        <p>Le robot mBot utilisé en classe est accompagné de notices d'utilisation. Tu trouveras également ci-dessous des ressources vidéo et des fiches complémentaires sur les notions de cette activité.</p>
        <div class="ressources-grille">
          <div class="ressource-carte">
            <div class="ressource-type">📘 Notice</div>
            <div class="ressource-titre">Notice d'utilisation mBot V2</div>
            <a href="https://ent2d.ac-bordeaux.fr/disciplines/sti-college/wp-content/uploads/sites/63/2023/01/Notice-dutilisation-mBot-V2.pdf" target="_blank" rel="noopener noreferrer" class="ressource-btn">Consulter la notice →</a>
          </div>
          <div class="ressource-carte">
            <div class="ressource-type">📘 Notice</div>
            <div class="ressource-titre">Notice d'utilisation mBot V1</div>
            <a href="https://ent2d.ac-bordeaux.fr/disciplines/sti-college/wp-content/uploads/sites/63/2022/11/Notice-dutilisation-mBot-V1.docx.pdf" target="_blank" rel="noopener noreferrer" class="ressource-btn">Consulter la notice →</a>
          </div>
          <div class="ressource-carte">
            <div class="ressource-type">🎬 Vidéo</div>
            <div class="ressource-titre">SFC1d — Mécanismes de transmission et de transformation des mouvements</div>
            <a href="https://podeduc.apps.education.fr/video/113140-sfc1d-sfc1d-les-mecanismes-de-transmission-et-de-transformation-de-mouvements-engrenages-courroies-chaines/" target="_blank" rel="noopener noreferrer" class="ressource-btn">Regarder la vidéo →</a>
          </div>
          <div class="ressource-carte">
            <div class="ressource-type">🎬 Vidéo</div>
            <div class="ressource-titre">SFC1i — Fonctions des constituants de la chaîne d'information</div>
            <a href="https://podeduc.apps.education.fr/video/113105-sfc1i-les-fonctions-des-constituants-suivants-capteurs-temperature-presence-distance-etc-microcontroleur-composants-dune-interface-entre-lhumain-et-la-machine-ihm-boutons-afficheurs/" target="_blank" rel="noopener noreferrer" class="ressource-btn">Regarder la vidéo →</a>
          </div>
          <div class="ressource-carte">
            <div class="ressource-type">📄 Fiche ressource</div>
            <div class="ressource-titre">SFC1d — Fiche ressource</div>
            <a href="https://nuage01.apps.education.fr/index.php/s/2x4oPnnoGSWpNiZ?dir=/&editing=false&openfile=true" target="_blank" rel="noopener noreferrer" class="ressource-btn">Ouvrir la ressource →</a>
          </div>
          <div class="ressource-carte">
            <div class="ressource-type">📄 Fiche ressource</div>
            <div class="ressource-titre">SFC1i — Fiche ressource</div>
            <a href="https://nuage01.apps.education.fr/index.php/s/CZzJjbTiL2GwB68?dir=/&editing=false&openfile=true" target="_blank" rel="noopener noreferrer" class="ressource-btn">Ouvrir la ressource →</a>
          </div>
        </div>
      </div>

    </div>
  </ActivitySection>
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }

  /* ── Compétences ── */
  .competences-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding: 0.75rem 1rem;
    background: #f0f4ff;
    border-radius: 0.5rem;
    border: 1px solid #c7d7f9;
  }

