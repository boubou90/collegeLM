---
import ClassLayout from '../../../layouts/ClassLayout.astro';
import ActivitySection from '../../../components/ActivitySection.astro';
import BackButton from '../../../components/BackButton.astro';

const level = "3eme";
const documents: { title: string; pdfUrl?: string; imageUrl?: string }[] = [
  {
    title: "Activité 1 — Les secrets d'un mBot",
    pdfUrl: "/documents/3eme/sequence-8/activite-1/activite-1.pdf"
  }
];
---

<ClassLayout title="Activité 1 - Séquence 8 - 3ème" level={level}>
  <BackButton href={`/${level}/sequence-8`} />
  <h1>Séquence 8 – Les secrets du mBot · Activité 1</h1>

  <ActivitySection
    title="Les secrets d'un mBot"
    description="Durée : 0h30 — Cette activité de lancement te fait découvrir le robot mBot, l'objet technique que tu vas étudier tout au long de la séquence. Tu vas observer une situation, formuler un problème technique et proposer des idées pour le résoudre, avant de partir à la découverte de son fonctionnement et de ses matériaux."
    documents={documents}
    activityNumber={1}
    totalActivities={3}
    sequenceHref="/3eme/sequence-8"
    sequenceLabel="Séquence 8 – Les secrets du mBot"
    retenir={{
      definitions: [
        { term: "Objet technique", def: "Objet fabriqué par l'être humain pour répondre à un besoin, qui a été conçu, fabriqué puis, un jour, jeté ou recyclé." },
        { term: "Problème technique", def: "Question concrète que l'on cherche à résoudre en observant le fonctionnement ou les limites d'un objet technique." },
        { term: "Résolution créative", def: "Démarche qui consiste à observer, formuler un problème, proposer plusieurs idées, puis choisir et améliorer la plus adaptée." },
      ],
      points: [
        "Le robot mBot est un objet technique qui, comme tous les objets, est fabriqué, utilisé puis, un jour, jeté.",
        "Cette séquence explore deux pistes : comment le robot fonctionne (activité 2) et quels matériaux le composent et avec quel impact sur l'environnement (activité 3).",
        "Résoudre un problème technique de façon créative, c'est observer, formuler un problème, proposer plusieurs idées puis choisir et améliorer une solution.",
      ]
    }}
  >
    <div class="activity-content">

      <!-- ══════════ COMPÉTENCES ══════════ -->
      <div class="competences-box">
        <span class="competences-titre">Compétences travaillées</span>
        <span class="competence-tag">T6 — Chaîne d'énergie</span>
        <span class="competence-tag">T7 — Matériaux et procédés</span>
        <span class="competence-tag">T8 — Fonctions, solutions et constituants de la chaîne d'information</span>
        <span class="competence-tag cps">CPS C3 — Prendre des décisions constructives · C32 — Résoudre un problème de façon créative</span>
      </div>

      <!-- ══════════ OBJECTIF ══════════ -->
      <div class="section-bloc objectif">
        <h3>🎯 Pourquoi étudier le mBot ?</h3>
        <p>Le <strong>mBot</strong> est un petit robot mobile : il roule, détecte son environnement et réagit tout seul. C'est un objet technique idéal pour découvrir à la fois <strong>comment un système technique fonctionne</strong> (moteurs, capteurs, chaîne d'énergie, chaîne d'information) et <strong>de quoi il est fait</strong> (matériaux, impact environnemental). Cette première activité te sert d'introduction avant d'entrer dans le détail au fil des deux activités suivantes.</p>
      </div>

      <!-- ══════════ SITUATION ══════════ -->
      <div class="section-bloc">
        <h3>📺 Ce que tu vas observer</h3>
        <p>La séance démarre par le visionnage d'une <strong>vidéo</strong> qui montre que nos objets technologiques du quotidien sont fabriqués, utilisés, puis — un jour — jetés en fin de vie.</p>
        <div class="problematique-box">
          <strong>Problématique :</strong> Comment fonctionnent tous ces objets ? Comment limiter l'accumulation des déchets ?
        </div>
      </div>

      <!-- ══════════ CE QU'ILS VONT CHERCHER À COMPRENDRE ══════════ -->
      <div class="section-bloc">
        <h3>🔍 Ce que tu vas chercher à comprendre</h3>
        <p>À partir de cette observation, deux pistes d'étude vont être suivies pour un robot mBot démonté, à l'aide de sa notice d'utilisation :</p>
        <div class="categories-grille">
          <div class="categorie-carte usager">
            <div class="categorie-icone">⚙️</div>
            <div class="categorie-titre">Comment il fonctionne</div>
            <div class="categorie-desc">Ses moteurs, ses capteurs, sa chaîne d'énergie et sa chaîne d'information — étudiés dans l'activité 2.</div>
          </div>
          <div class="categorie-carte donnees">
            <div class="categorie-icone">🌍</div>
            <div class="categorie-titre">De quoi il est fait</div>
            <div class="categorie-desc">Ses matériaux et leur impact sur l'environnement — étudiés dans l'activité 3.</div>
          </div>
        </div>
      </div>

      <!-- ══════════ DÉMARCHE ══════════ -->
      <div class="section-bloc">
        <h3>💡 La démarche de résolution créative</h3>
        <p>Pour formuler et résoudre un problème technique, la fiche d'activité te guide en 4 étapes :</p>
        <ul class="demarche-liste">
          <li><strong>Constats, observations</strong> — qu'as-tu remarqué dans la vidéo ?</li>
          <li><strong>Problème à résoudre</strong> — quelle question technique se pose ?</li>
          <li><strong>Idées pour le résoudre</strong> — quelles pistes peux-tu imaginer ?</li>
          <li><strong>Idées retenues</strong> — quelles idées choisis-tu de creuser dans la suite de la séquence ?</li>
        </ul>
        <p class="section-info">Cette démarche mobilise ta compétence psychosociale <strong>C3.2</strong> : résoudre un problème technique de façon créative, en proposant puis en améliorant plusieurs solutions.</p>
      </div>

      <!-- ══════════ À RETENIR AVANT DE COMMENCER ══════════ -->
      <div class="section-bloc">
        <h3>🧭 Avant de commencer la fiche</h3>
        <p>Cette page ne remplace pas la fiche d'activité : elle te donne le contexte pour bien démarrer. Les zones "constats", "problème", "idées" et "idées retenues" sont à compléter directement sur ta fiche, à partir de ce que tu auras observé dans la vidéo.</p>
      </div>

    </div>
  </ActivitySection>
</ClassLayout>

<style>
  h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 2rem;
  }

  /* ── Compétences ── */
  .competences-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding: 0.75rem 1rem;
    background: #f0f4ff;
    border-radius: 0.5rem;
    border: 1px solid #c7d7f9;
  }

  :global([data-theme="dark"]) .competences-box {
    background: var(--card-bg);
    color: var(--text);
    border-color: var(--border-color);
  }

  .competences-titre {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: 100%;
  }

  :global([data-theme="dark"]) .competences-titre {
    color: var(--text);
  }

  .competence-tag {
    font-size: 0.78rem;
    font-weight: 600;
    color: #1e3a8a;
    background: #dbeafe;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }

  :global([data-theme="dark"]) .competence-tag {
    background: #1e3a5f;
    color: var(--primary-dark);
  }

  .competence-tag.cps {
    background: #ede9fe;
    color: #5b21b6;
  }

  :global([data-theme="dark"]) .competence-tag.cps {
    background: #312e81;
    color: #c4b5fd;
  }

  /* ── Sections ── */
  .section-bloc {
    margin: 1.75rem 0;
  }

  .section-bloc h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1e3a8a;
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid #dbeafe;
  }

  :global([data-theme="dark"]) .section-bloc h3 {
    color: var(--primary-dark);
    border-bottom-color: var(--border-color);
  }

  .section-info {
    margin-top: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: #f1f5fb;
    border-left: 3px solid #1e3a8a;
    border-radius: 0 0.4rem 0.4rem 0;
    font-size: 0.88rem;
    color: #1e3a8a;
    line-height: 1.6;
  }

  :global([data-theme="dark"]) .section-info {
    background: #1e3a5f;
    color: var(--text);
    border-left-color: var(--primary-dark);
  }

  /* ── Objectif ── */
  .objectif {
    background: #f8faff;
    border: 1px solid #dbeafe;
    border-radius: 0.6rem;
    padding: 1rem 1.25rem;
  }

  :global([data-theme="dark"]) .objectif {
    background: var(--card-bg);
    color: var(--text);
    border-color: var(--border-color);
  }

  .problematique-box {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    background: #1e3a8a;
    color: #fff;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ── Catégories ── */
  .categories-grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .categorie-carte {
    border-radius: 0.5rem;
    padding: 0.9rem;
    border: 1px solid;
    text-align: center;
  }

  .categorie-carte.usager  { background: #eff6ff; border-color: #93c5fd; }
  .categorie-carte.donnees { background: #f0fdf4; border-color: #86efac; }

  .categorie-icone { font-size: 1.75rem; margin-bottom: 0.3rem; }

  .categorie-titre {
    font-weight: 800;
    font-size: 0.85rem;
    color: #1e293b;
    margin-bottom: 0.4rem;
  }

  .categorie-desc {
    font-size: 0.78rem;
    color: #475569;
    line-height: 1.5;
  }

  /* ── Démarche ── */
  .demarche-liste {
    font-size: 0.875rem;
    line-height: 1.8;
    padding-left: 1.25rem;
    color: #334155;
    margin: 0.5rem 0;
  }

  :global([data-theme="dark"]) .demarche-liste {
    color: var(--text);
  }
</style>
